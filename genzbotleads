USERS_PER_PAGE = 10

def fmt_ago(ts):
    if not ts:
        return "N/A"
    seconds = int(time.time()) - int(ts)
    if seconds < 0:
        seconds = 0
    if seconds < 60:
        return f"{seconds} second{'s' if seconds != 1 else ''} ago"
    if seconds < 3600:
        m = seconds // 60
        return f"{m} minute{'s' if m != 1 else ''} ago"
    if seconds < 86400:
        h = seconds // 3600
        return f"{h} hour{'s' if h != 1 else ''} ago"
    d = seconds // 86400
    return f"{d} day{'s' if d != 1 else ''} ago"

def get_all_users_sorted():
    users = {}
    for r in (db_run("SELECT telegram_id, full_name FROM access") or []):
        users[str(r[0])] = {'name': r[1] or '', 'last': 0}
    for r in (db_run("SELECT telegram_id FROM users") or []):
        users.setdefault(str(r[0]), {'name': '', 'last': 0})
    for r in (db_run("SELECT telegram_id, full_name, last_active FROM activity") or []):
        u = users.setdefault(str(r[0]), {'name': '', 'last': 0})
        if r[1]:
            u['name'] = r[1]
        u['last'] = int(r[2] or 0)

    items = [(uid, d['name'] or 'Unknown', d['last']) for uid, d in users.items()]
    items.sort(key=lambda x: x[2], reverse=True)  # সবচেয়ে সাম্প্রতিক active আগে
    return items

def build_users_page(page):
    items = get_all_users_sorted()
    total = len(items)
    total_pages = max(1, (total + USERS_PER_PAGE - 1) // USERS_PER_PAGE)
    page = max(1, min(page, total_pages))

    start = (page - 1) * USERS_PER_PAGE
    page_items = items[start:start + USERS_PER_PAGE]

    now = int(time.time())
    text = f"👥 <b>ALL USERS</b> (Page {page}/{total_pages})\n"
    text += f"Total: {total}\n\n"

    if not page_items:
        text += "❌ No users found."
    for i, (uid, name, last) in enumerate(page_items, start=start + 1):
        icon = "🟢" if last and (now - last) < 300 else "⚪"
        text += (
            f"<b>{i}.</b> {icon} {html.escape(name)}\n"
            f"🆔 <code>{uid}</code>\n"
            f"🕒 {fmt_ago(last)}\n\n"
        )

    markup = types.InlineKeyboardMarkup()
    markup.row(
        types.InlineKeyboardButton("⬅️ Prev", callback_data=f"usrpg_{page - 1}"),
        types.InlineKeyboardButton("🔄 Refresh", callback_data=f"usrpg_{page}"),
        types.InlineKeyboardButton("Next ➡️", callback_data=f"usrpg_{page + 1}")
    )
    return text, markup, page, total_pages

