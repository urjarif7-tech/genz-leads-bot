''')

def proxy_price(kind):
    return PROXY_PRICES.get(kind, 5.0)

def load_prices():
    """ডাটাবেসে সেভ করা দাম মেমরিতে আনে। সফল হলে True।"""
    rows = db_run("SELECT item, price FROM prices")
    if rows is None:
        return False
    for item, price in rows:
        try:
            v = float(price)
        except Exception:
            continue
        if item in SERVICES_PRICES:
            SERVICES_PRICES[item] = v
        elif item.startswith('proxy_') and item[6:] in PROXY_PRICES:
            PROXY_PRICES[item[6:]] = v
    return True

def _prices_loader():
    # ডাটাবেস না পেলে ৩০ সেকেন্ড পর পর আবার চেষ্টা করে, যাতে সেভ করা দাম হারিয়ে ডিফল্ট দামে না চলে
