DUE_ENTRIES_PER_PAGE = 8

def generate_due_query_text(telegram_id, page=1, admin=False):
    uid = str(telegram_id)
    u_data = get_user_db_strict(uid)

    def cb(n):
        return f"admdue_{uid}_{n}" if admin else f"duepage_{n}"

    if u_data is None:
        markup = types.InlineKeyboardMarkup()
        markup.row(types.InlineKeyboardButton("🔄 Refresh", callback_data=cb(page)))
        if not admin:
            markup.add(types.InlineKeyboardButton("🔙 Back", callback_data="go_welcome"))
        return "⚠️ Something went wrong. Please try again.", markup

    logs = u_data['due_logs']

    if not logs:
        text = "📋 **YOUR DUE SUMMARY**\n-------------------------\n❌ আপনার কোনো ব্যালেন্স এড বা Due রেকর্ড নেই।"
        markup = types.InlineKeyboardMarkup()
        if not admin:
            markup.add(types.InlineKeyboardButton("🔙 Back", callback_data="go_welcome"))
        return text, markup

    tot_due = 0.0
    tot_paid = 0.0
    due_entries = []
    paid_entries = []
    for entry in logs:
        p = _f(entry.get('price'))
        pd = _f(entry.get('paid'))
        rem = max(0.0, p - pd)
        tot_due += rem
        tot_paid += pd
        (due_entries if rem > 1e-9 else paid_entries).append((entry, p, pd, rem))

    ordered = due_entries + paid_entries   # আগে Due, তারপর Paid
    total_pages = max(1, (len(ordered) + DUE_ENTRIES_PER_PAGE - 1) // DUE_ENTRIES_PER_PAGE)
    page = max(1, min(int(page), total_pages))
    chunk = ordered[(page - 1) * DUE_ENTRIES_PER_PAGE: page * DUE_ENTRIES_PER_PAGE]

    text = f"📋 **YOUR DUE SUMMARY** (Page {page}/{total_pages})\n-------------------------\n"
    for entry, p, pd, rem in chunk:
        status_tag = "✅ Paid" if rem <= 1e-9 else "🔴 Due"
        text += f"🛒 Balance {status_tag}\n"
        text += f"Date:        {entry.get('date', 'N/A')}\n"
        text += f"Price:       {p:,.1f} TK\n"
        text += f"Paid:        {pd:,.1f} TK\n"
        text += f"Remaining: {rem:,.1f} TK\n"
        text += "-------------------------\n"

    text += f"Total Due:   {tot_due:,.1f} TK\n"
    text += f"Total Paid:  {tot_paid:,.1f} TK\n"
    text += f"Balance:     {_f(u_data.get('balance')):,.1f} TK\n"
    text += "-------------------------\n"
    text += "MONTHLY SPENDING\n"

    # চলতি মাস = এখনকার এন্ট্রি থেকে, আগের মাসগুলো = মাস শেষে সংরক্ষিত মোট
    cur_key = current_month_key()
    live = sum(_f(e.get('price')) for e in logs if entry_month(e.get('date')) == cur_key)
    saved = (u_data.get('meta') or {}).get('monthly_added', {})
    for i in range(5):
        k = month_key_back(i)
        amt = live if i == 0 else _f(saved.get(k, 0.0))
        text += f"{k}: {amt:,.1f} TK\n"

    markup = types.InlineKeyboardMarkup()
    nav = []
    if page > 1:
        nav.append(types.InlineKeyboardButton("⬅️ Prev", callback_data=cb(page - 1)))
    nav.append(types.InlineKeyboardButton("🔄 Refresh", callback_data=cb(page)))
    if page < total_pages:
        nav.append(types.InlineKeyboardButton("Next ➡️", callback_data=cb(page + 1)))
    markup.row(*nav)
    if not admin:
        markup.add(types.InlineKeyboardButton("🔙 Back", callback_data="go_welcome"))

    return text, markup

