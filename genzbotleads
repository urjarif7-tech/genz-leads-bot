ADMIN_INBOX_MAX_PAGES = 5            # অ্যাডমিনের Broadcasts পেজে সর্বোচ্চ ৫ পেজ সেভ থাকে
admin_inbox_lock = threading.Lock()

def user_full_name(user):
    return f"{user.first_name or ''} {user.last_name or ''}".strip() or "Unknown"

def trim_admin_inbox():
    """অ্যাডমিনের Broadcasts এ ৫ পেজের বেশি যা আছে তা ডাটাবেস থেকে মুছে দেয়।"""
    rows = db_run(
        "SELECT id, ts, content_type, body FROM broadcasts WHERE telegram_id = ? ORDER BY ts DESC, id DESC LIMIT 200",
        [str(ADMIN_ID)]
    )
    if not rows:
        return
    entries = [_bc_entry(int(r[1] or 0), r[2], r[3]) for r in rows]
    _, kept = _bc_pack(entries, ADMIN_INBOX_MAX_PAGES)
    if 0 < kept < len(rows):
        keep_ids = [int(r[0]) for r in rows[:kept]]
        marks = ",".join("?" * len(keep_ids))
        db_run(f"DELETE FROM broadcasts WHERE telegram_id = ? AND id NOT IN ({marks})", [str(ADMIN_ID)] + keep_ids)

def save_user_message_for_admin(user_id, name, text):
    body = json.dumps({'name': name, 'uid': str(user_id), 'text': text}, ensure_ascii=False)
    with admin_inbox_lock:
        res = db_run(
            "INSERT INTO broadcasts (telegram_id, ts, content_type, body) VALUES (?, ?, ?, ?)",
            [str(ADMIN_ID), int(time.time()), 'user_message', body]
        )
        trim_admin_inbox()
    return res is not None

def deliver_message_to_admin(user, text):
    """অ্যাডমিনকে নাম, আইডি, সময় আর মেসেজ পাঠায়। লম্বা হলে একাধিক মেসেজে ভাগ করে। প্রথমটা গেলে True।"""
    name = html.escape(user_full_name(user))
    header = (
        "📨 <b>NEW MESSAGE</b>\n\n"
        f"👤 Name: {name}\n"
        f"🆔 User ID: <code>{user.id}</code>\n"
        f"🕒 {fmt_bd_time(time.time())}\n\n"
    )
    chunks = _chatlog_chunks(text)
    for i, piece in enumerate(chunks):
        if i == 0:
            prefix = header
        else:
            prefix = f"📨 <b>NEW MESSAGE</b> (part {i + 1}/{len(chunks)})\n🆔 <code>{user.id}</code>\n\n"
        try:
            bot.send_message(ADMIN_ID, prefix + "💬 " + html.escape(piece, quote=False), parse_mode='HTML')
        except Exception as e:
            print(f"Deliver message to admin error: {e}")
            if i == 0:
                return False
    return True

