@bot.message_handler(
    func=lambda m: m.from_user.id == ADMIN_ID and is_broadcast_waiting() and not (m.text or '').startswith('/'),
    content_types=BROADCAST_CONTENT_TYPES
)
def handle_broadcast_content(message):
    state = broadcast_states.pop(ADMIN_ID, None)
    if not state:
        return

    # প্রম্পটের Cancel বাটন সরিয়ে দিই
    try:
        bot.edit_message_reply_markup(message.chat.id, state['prompt_id'], reply_markup=None)
    except Exception:
        pass

    target = state['target']

    if target == 'all':
        recipients = [uid for uid, _, _ in get_all_users_sorted() if int(uid) != ADMIN_ID]
        if not recipients:
            bot.reply_to(message, "❌ No users to send to.")
            return
        bot.reply_to(message, f"📤 Sending to {len(recipients)} users...")
        threading.Thread(
            target=run_broadcast_all,
            args=(recipients, message.chat.id, message),
            daemon=True
        ).start()
    else:
        if send_broadcast_to(target, message.chat.id, message):
            bot.reply_to(message, f"✅ Message sent to `{target}`.", parse_mode='Markdown')
        else:
            bot.reply_to(
                message,
                f"❌ Could not send to `{target}`.\nUser may have blocked the bot or never started it.",
                parse_mode='Markdown'
            )
