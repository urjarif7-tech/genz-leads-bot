PROXY_UNIT_PRICE = 5.0

def verify_proxy(proxy_url, timeout=8):
    """প্রক্সি দিয়ে আসলে ইন্টারনেট চলে কি না পরীক্ষা করে। (সফল?, তথ্য)"""
    proxies = {'http': proxy_url, 'https': proxy_url}
    for test_url in ('https://ipinfo.io/json', 'https://api.ipify.org?format=json'):
        try:
            r = requests.get(test_url, proxies=proxies, timeout=timeout)
            if r.status_code == 200:
                try:
                    info = r.json()
                    if not isinstance(info, dict):
                        info = {}
                except Exception:
                    info = {}
                return True, info
        except Exception:
            continue
    return False, {}

def verify_proxies_parallel(urls):
    results = [(False, {})] * len(urls)

    def worker(i, url):
        results[i] = verify_proxy(url)

    threads = [threading.Thread(target=worker, args=(i, u), daemon=True) for i, u in enumerate(urls)]
    for t in threads:
        t.start()
    for t in threads:
        t.join(timeout=30)
    return results

def get_verified_proxies(fetch_fn, quantity, rounds=2):
    """চালু (working) প্রক্সির তালিকা [(url, info)]। কিছু ফেল করলে একবার নতুন করে চেষ্টা করে।"""
    working = []
    for _ in range(rounds):
        need = quantity - len(working)
        if need <= 0:
            break
        urls = (fetch_fn(need) or [])[:need]
        if not urls:
            continue
        results = verify_proxies_parallel(urls)
        for url, (ok, info) in zip(urls, results):
            if ok:
                working.append((url, info))
    return working

def fetch_cliproxy_list(quantity, state_name):
    urls = []
    try:
        clip_api = f"https://webipapi.cliproxy.com/api/getIpInfo?key={CLIPROXY_KEY}&port=443&num={quantity}&country=US&state={state_name}&type=2"
        res = requests.get(clip_api, timeout=8)
        if res.status_code == 200:
            for line in res.text.strip().splitlines():
                line = line.strip()
                if not line:
                    continue
                if line.startswith(('http://', 'https://', 'socks5://', 'socks4://')):
                    urls.append(line)
                    continue
                parts = line.split(':')
                if len(parts) == 4:
                    host, port, username, password = parts
                    urls.append(f"http://{username}:{password}@{host}:{port}")
                elif len(parts) == 2:
                    urls.append(f"http://{line}")
            if not urls:
                print(f"Cliproxy unexpected response: {res.text[:200]}")
        else:
            print(f"Cliproxy HTTP {res.status_code}: {res.text[:200]}")
    except Exception as e:
        print(f"Cliproxy API Error: {e}")
    return urls

