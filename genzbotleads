def build_lead_message(data):
    leads = data.get('data', [])
    current_page = data.get('current_page', 1)
    last_page = min(data.get('last_page', 1), 5)

    if not leads:
        return "🎯 No Live Leads Found!", None

    message_text = f"🎯 Live Leads List (Page {current_page}/{last_page})\n\n"
    
    for lead in leads:
        user_id = str(lead.get('user_id', 'N/A')).replace('*', '')
        offer_name = str(lead.get('offer_name', 'N/A')).replace('*', '')
        provider = str(lead.get('provider', 'N/A')).replace('*', '')
        points = str(lead.get('points', '0')).replace('*', '')
        time_ago = str(lead.get('time_ago', 'Just now')).replace('*', '')

        message_text += f"👤 User ID: {user_id}\n"
        message_text += f"📌 Offer: {offer_name}\n"
        message_text += f"🌐 Provider: {provider}\n"
        message_text += f"💰 Reward: {points} Points\n"
        message_text += f"⏱️ Time: {time_ago}\n\n"

    markup = types.InlineKeyboardMarkup()
    markup.add(types.InlineKeyboardButton("🔄 Refresh", callback_data=f"page_{current_page}"))

    nav_buttons = []
    if current_page > 1:
        nav_buttons.append(types.InlineKeyboardButton("⬅️ Prev", callback_data=f"page_{current_page - 1}"))
    if current_page < last_page:
        nav_buttons.append(types.InlineKeyboardButton("➡️ Next", callback_data=f"page_{current_page + 1}"))

    if nav_buttons:
        markup.row(*nav_buttons)

    markup.add(types.InlineKeyboardButton("🔙 Back", callback_data="go_welcome"))
    return message_text, markup

def generate_due_query_text(telegram_id):
    uid = str(telegram_id)
    u_data = get_user_db(uid)
    logs = u_data['due_logs']

    text = "📋 **YOUR DUE SUMMARY**\n-------------------------\n"

    if not logs:
        text += "❌ আপনার কোনো ব্যালেন্স এড বা Due রেকর্ড নেই।"
        markup = types.InlineKeyboardMarkup()
        markup.add(types.InlineKeyboardButton("🔙 Back", callback_data="go_welcome"))
        return text, markup

    tot_due = 0.0
    tot_paid = 0.0

    for entry in logs:
        p = float(entry.get('price', 0.0))
        pd = float(entry.get('paid', 0.0))
        rem = max(0.0, p - pd)
        
        tot_due += rem
        tot_paid += pd

        status_tag = "✅ Paid" if rem == 0 else "🔴 Due"
        
        text += f"🛒 Balance {status_tag}\n"
        text += f"Date:        {entry.get('date', 'N/A')}\n"
        text += f"Price:       {p:,.1f} TK\n"
        text += f"Paid:        {pd:,.1f} TK\n"
        text += f"Remaining: {rem:,.1f} TK\n"
        text += "-------------------------\n"

    curr_bal = get_effective_balance(uid)

    text += f"Total Due:   {tot_due:,.1f} TK\n"
    text += f"Total Paid:  {tot_paid:,.1f} TK\n"
    text += f"Balance:     {curr_bal:,.1f} TK\n"
    text += "-------------------------\n"
    text += "MONTHLY SPENDING\n"

    monthly_spend = defaultdict(float)
    for entry in logs:
        try:
            e_date = datetime.strptime(entry.get('date', ''), "%Y-%m-%d")
            m_key = e_date.strftime("%Y-%m")
            monthly_spend[m_key] += float(entry.get('price', 0.0))
        except Exception:
            pass

    bd_now = datetime.utcnow() + timedelta(hours=6)
    month_keys = []
    for i in range(5):
        m_date = bd_now - timedelta(days=30 * i)
        month_keys.append(m_date.strftime("%Y-%m"))

    for m_k in month_keys:
        amt = monthly_spend.get(m_k, 0.0)
        text += f"{m_k}: {amt:,.1f} TK\n"

    markup = types.InlineKeyboardMarkup(row_width=2)
    btn_refresh = types.InlineKeyboardButton("🔄 Refresh", callback_data="due_query")
    btn_back = types.InlineKeyboardButton("🔙 Back", callback_data="go_welcome")
    markup.add(btn_refresh, btn_back)

    return text, markup

