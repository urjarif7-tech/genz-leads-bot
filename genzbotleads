@bot.callback_query_handler(func=lambda call: call.data.startswith('buy_clip_'))
def handle_buy_clip_confirm(call):
    parts = call.data.split('_')
    state_code = parts[2].lower()
    state_name = parts[2].capitalize()
    quantity = int(parts[3])
    cost = quantity * 5.0

    balance = get_effective_balance(call.from_user.id)

    if balance < cost:
        bot.answer_callback_query(call.id, text=f"❌ Insufficient balance! Required: {cost} TK", show_alert=True)
        return

    proxy_urls_list = []
    ip_details_list = []

    try:
        clip_api = f"https://webipapi.cliproxy.com/api/getIpInfo?key={CLIPROXY_KEY}&port=443&num={quantity}&country=US&state={state_name}&type=2"
        res = requests.get(clip_api, timeout=10)
        if res.status_code == 200:
            lines = res.text.strip().splitlines()
            for line in lines:
                line_str = line.strip()
                if line_str:
                    parts_ip = line_str.split(':')
                    if len(parts_ip) == 4 and not line_str.startswith("http") and not line_str.startswith("socks"):
                        host, port, username, password = parts_ip
                        formatted_proxy = f"http://{username}:{password}@{host}:{port}"
                        proxy_urls_list.append(formatted_proxy)
                        
                        try:
                            ip_info = requests.get(f"http://ipinfo.io/{host}/json", timeout=3).json()
                            isp = ip_info.get("org", "Unknown ISP")
                            city = ip_info.get("city", state_name)
                            ip_details_list.append(f"📡 ISP: {isp}\n📍 Exit: {city}, {state_name} ({host})")
                        except Exception:
                            ip_details_list.append(f"📍 Exit: {state_name} ({host})")
                    else:
                        proxy_urls_list.append(line_str)
                        ip_details_list.append(f"📍 Exit: {state_name}")
    except Exception as e:
        print(f"Cliproxy API Error: {e}")

    if not proxy_urls_list:
        for _ in range(quantity):
            session_id = random.randint(100000, 999999)
            username = f"{TRUSTSOURCE_USERNAME}-zone-custom-region-US-st-{state_name}-session-{session_id}-sessTime-10"
            proxy_urls_list.append(f"http://{username}:{TRUSTSOURCE_PASSWORD}@{TRUSTSOURCE_HOST}:{TRUSTSOURCE_PORT}")
            ip_details_list.append(f"📍 Gateway: {TRUSTSOURCE_HOST}:{TRUSTSOURCE_PORT}")

    uid = str(call.from_user.id)
    u_data = get_user_db(uid)
    u_data['balance'] -= cost
    u_data['spend'] += cost
    u_data['due'] += cost

    bd_time = datetime.utcnow() + timedelta(hours=6)
    purchase_log = {
        'date': bd_time.strftime("%d/%m/%Y"),
        'time': bd_time.strftime("%I:%M %p").lower(),
        'state': f"Cliproxy ({state_name})",
        'quantity': quantity,
        'cost': cost
    }
    u_data['purchases'].insert(0, purchase_log)
    save_user_db(uid, u_data)

    proxy_display_text = "\n".join(proxy_urls_list)
    details_display_text = "\n".join(ip_details_list)

    qr = qrcode.QRCode(version=1, box_size=10, border=4)
    qr.add_data(proxy_display_text)
    qr.make(fit=True)
    img = qr.make_image(fill_color="black", back_color="white")

    img_byte_arr = io.BytesIO()
    img.save(img_byte_arr, format='PNG')
    img_byte_arr.seek(0)

    caption = (
        f"✅ **PROXY VERIFIED & CHARGED ({len(proxy_urls_list)}/{quantity})**\n\n"
        f"💳 Charged: {cost} TK\n"
        f"🖼️ {state_name}, United States\n"
        f"{details_display_text}\n\n"
        f"`{proxy_display_text}`"
    )

    try:
        bot.delete_message(call.message.chat.id, call.message.message_id)
    except Exception:
        pass
        
    bot.send_photo(call.message.chat.id, photo=img_byte_arr, caption=caption, parse_mode='Markdown')

    remaining_balance = get_effective_balance(call.from_user.id)
    summary_text = (
