RESET_CONFIRM_SECONDS = 5 * 60
reset_pending = {}   # target user id (str) -> কখন কনফার্মেশন চাওয়া হয়েছে

def perform_user_reset(target):
    """ইউজারের সব ডাটা (ব্যালেন্স, due/paid, purchase history, ব্যাংক তথ্য, সেভ করা ব্রডকাস্ট) মুছে দেয়।
    বটে ঢোকার অনুমতি (approved status) থাকে। সফল হলে True।"""
    key = str(target).strip()
    cancel_ids = []
    with user_lock(key):
        # পুরনো ইউজার (access টেবিলে নেই) আগে approved হিসেবে সংরক্ষণ হয়, যাতে ডাটা মোছার পর লক না হয়ে যায়
        acc = get_access(key)
        if acc['status'] == 'error':
            return False

        # SMS এর অপেক্ষায় থাকা নম্বর আর আটকানো টাকা বাতিল
        with orders_lock:
            for oid in [o for o, v in active_orders.items() if str(v['uid']) == key]:
                active_orders.pop(oid, None)
                cancel_ids.append(oid)
            for tok in [t for t, v in block_tokens.items() if str(v['uid']) == key]:
                block_tokens.pop(tok, None)
        held_amounts[key] = 0.0

        results = [
            db_run("DELETE FROM users WHERE telegram_id = ?", [key]),
            db_run("DELETE FROM bank WHERE telegram_id = ?", [key]),
            db_run("DELETE FROM broadcasts WHERE telegram_id = ?", [key]),
            db_run("DELETE FROM broadcasts WHERE telegram_id = ? AND content_type = 'user_message' AND body LIKE ?", [str(ADMIN_ID), '%"uid": "' + key + '"%']),
        ]
        if any(r is None for r in results):
            return False

    try:
        clear_user_flows(int(key))
    except Exception:
        pass
    chatlog_forget_user(key)
    for oid in cancel_ids:
        cancel_durian_number_api(oid)
    return True

