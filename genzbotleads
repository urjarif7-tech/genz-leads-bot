def _f(v):
    try:
        return float(v)
    except Exception:
        return 0.0

def _default_user():
    return {
        'balance': 0.0, 'spend': 0.0, 'due': 0.0, 'paid': 0.0,
        'purchases': [], 'due_logs': [],
        'meta': {'month': current_month_key(), 'monthly_added': {}}
    }

def _json_list(raw):
    try:
        v = json.loads(raw) if raw else []
        return v if isinstance(v, list) else []
    except Exception:
        return []

def _json_dict(raw):
    try:
        v = json.loads(raw) if raw else {}
        return v if isinstance(v, dict) else {}
    except Exception:
        return {}

def _normalize_user(u):
    """মাস বদলালে (প্রতি মাসের ১ তারিখ রাত ১২টার পর প্রথম ব্যবহারে) নিজে নিজে:
    - পুরনো মাসের paid এন্ট্রি মুছে শুধু Due রাখে, Total Paid ০.০ করে
    - Total Spend (এই মাসের কেনাকাটা) নতুন করে শুরু করে
    - মাসের admin-added মোট হিসাব সংরক্ষণ করে (Monthly Spending এর জন্য)"""
    cur = current_month_key()
    meta = u.get('meta')
    if not isinstance(meta, dict):
        meta = {}
    monthly = meta.get('monthly_added')
    if not isinstance(monthly, dict):
        monthly = {}

    if meta.get('month') == cur:
        u['meta'] = {'month': cur, 'monthly_added': monthly}
        return u

    logs = u.get('due_logs') or []

    # ১) শেষ হয়ে যাওয়া মাসগুলোর admin-added মোট (যেগুলো আগে সেভ হয়নি) সংরক্ষণ
    sums = defaultdict(float)
    for e in logs:
        m = entry_month(e.get('date'))
        if m and m < cur and m not in monthly:
            sums[m] += _f(e.get('price'))
    for m, v in sums.items():
        monthly[m] = round(v, 2)
    for old_key in sorted(monthly.keys(), reverse=True)[12:]:
        monthly.pop(old_key, None)

    # ২) পুরনো মাসের paid এন্ট্রি মুছে ফেলা, আংশিক paid হলে শুধু বাকি অংশ Due হিসেবে থাকে
    new_logs = []
    for e in logs:
        m = entry_month(e.get('date'))
        if m is None or m < cur:
            rem = max(0.0, _f(e.get('price')) - _f(e.get('paid')))
            if rem > 1e-9:
                new_logs.append({'date': e.get('date'), 'price': rem, 'paid': 0.0})
        else:
            new_logs.append(e)
    u['due_logs'] = new_logs
    u['paid'] = 0.0

    # ৩) Total Spend = শুধু এই মাসের কেনাকাটা
    u['spend'] = sum(_f(p.get('cost')) for p in (u.get('purchases') or []) if entry_month(p.get('date')) == cur)

    u['meta'] = {'month': cur, 'monthly_added': monthly}
    return u

def _load_user(t_id):
    """ইউজারের ডাটা (নতুন ইউজার হলে শূন্য ডাটা)। ডাটাবেস error হলে None।"""
    stmt = "SELECT balance, spend, due, paid, purchases, due_logs, meta FROM users WHERE telegram_id = ?"
    if TURSO_URL and TURSO_TOKEN:
        result = execute_turso_query(stmt, [t_id])
        if result is None:
            return None
        rows = result.get("rows")
        if not rows:
            return _default_user()
        row = rows[0]

        def num(cell):
            v = cell.get("value")
            return float(v) if v is not None else 0.0

        u = {
            'balance': num(row[0]),
            'spend': num(row[1]),
            'due': num(row[2]),
            'paid': num(row[3]),
            'purchases': _json_list(row[4].get("value")),
            'due_logs': _json_list(row[5].get("value")),
            'meta': _json_dict(row[6].get("value"))
        }
        return _normalize_user(u)

    try:
        conn = sqlite3.connect(DB_FILE)
        try:
            cursor = conn.cursor()
            cursor.execute(stmt, (t_id,))
            row = cursor.fetchone()
        finally:
            conn.close()
    except Exception as e:
        print(f"SQLite read error: {e}")
        return None

    if not row:
        return _default_user()
    u = {
        'balance': float(row[0] or 0.0),
        'spend': float(row[1] or 0.0),
        'due': float(row[2] or 0.0),
        'paid': float(row[3] or 0.0),
        'purchases': _json_list(row[4]),
        'due_logs': _json_list(row[5]),
        'meta': _json_dict(row[6])
    }
    return _normalize_user(u)

