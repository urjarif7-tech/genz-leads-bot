PROXY_PRICE_LABELS = {'clip': 'Cliproxy', '711': '711 Proxy'}
PRICE_MAX = 100000.0
price_states = {}   # ADMIN_ID -> {'kind': 'n' | 'p', 'key': .., 'chat_id': .., 'msg_id': ..}

db_run('''
