def save_user_db(telegram_id, data):
    """সফল হলে True, না হলে False।"""
    t_id = str(telegram_id).strip()
    meta = data.get('meta')
    if not isinstance(meta, dict) or not meta:
        meta = {'month': current_month_key(), 'monthly_added': {}}
    args = [
        t_id,
        float(data.get('balance', 0.0)),
        float(data.get('spend', 0.0)),
        float(data.get('due', 0.0)),
        float(data.get('paid', 0.0)),
        json.dumps(data.get('purchases', [])),
        json.dumps(data.get('due_logs', [])),
        json.dumps(meta)
    ]
    stmt = '''
        INSERT OR REPLACE INTO users (telegram_id, balance, spend, due, paid, purchases, due_logs, meta)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?)
    '''
    if TURSO_URL and TURSO_TOKEN:
        return execute_turso_query(stmt, args) is not None

    try:
        conn = sqlite3.connect(DB_FILE)
        try:
            cursor = conn.cursor()
            cursor.execute(stmt, args)
            conn.commit()
        finally:
            conn.close()
        return True
    except Exception as e:
        print(f"SQLite write error: {e}")
        return False

