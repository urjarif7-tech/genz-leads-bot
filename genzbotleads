    bot.send_message(call.message.chat.id, "💰 Koto taka Balance add korte chan likhe pathan:", reply_markup=markup)
    bot.answer_callback_query(call.id)

@bot.callback_query_handler(func=lambda call: call.data == 'cancel_request')
def handle_cancel_request(call):
    admin_states.pop(call.from_user.id, None)
    try:
        bot.edit_message_text(
