def execute_turso_query(stmt, args=None):
    turso_endpoint = get_turso_http_url()
    if not turso_endpoint or not TURSO_TOKEN:
        return None

    headers = {
        "Authorization": f"Bearer {TURSO_TOKEN}",
        "Content-Type": "application/json"
    }

    formatted_args = []
    if args:
        for arg in args:
            if isinstance(arg, float):
                formatted_args.append({"type": "float", "value": arg})
            elif isinstance(arg, int):
                formatted_args.append({"type": "integer", "value": str(arg)})
            elif arg is None:
                formatted_args.append({"type": "null"})
            else:
                formatted_args.append({"type": "text", "value": str(arg)})

    payload = {
        "requests": [
            {
                "type": "execute",
                "stmt": {
                    "sql": stmt,
                    "args": formatted_args
                }
            },
            {"type": "close"}
        ]
    }

    for attempt in range(2):
        t0 = time.time()
        try:
            res = turso_session.post(turso_endpoint, json=payload, headers=headers, timeout=10)
            dt = time.time() - t0
            if dt > 1.0:
                print(f"⚠️ Slow Turso query ({dt:.2f}s): {stmt.strip()[:60]}")
            if res.status_code == 200:
                data = res.json()
                results = data.get("results", [])
                if results and results[0].get("type") == "ok":
                    return results[0].get("response", {}).get("result", {})
            return None
        except requests.exceptions.ConnectionError as e:
            # পুরনো কানেকশন বন্ধ হয়ে গেলে একবার নতুন কানেকশনে আবার চেষ্টা
            if attempt == 0:
                continue
            print(f"Turso HTTP Query Error: {e}")
        except Exception as e:
            print(f"Turso HTTP Query Error: {e}")
            break
    return None

