def parse_relative_time(created_val):
    if not created_val or str(created_val).lower() == 'n/a':
        return 'N/A'
    
    val_str = str(created_val).strip()
    
    if any(w in val_str.lower() for w in ['second', 'minute', 'hour', 'day', 'ago', 'just now']):
        return val_str

    try:
        dt = None
        for fmt in ("%d %b %Y, %I:%M %p", "%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M"):
            try:
                dt = datetime.strptime(val_str, fmt)
                break
            except ValueError:
                continue

        if not dt:
            dt = datetime.strptime(val_str.split('.')[0], "%Y-%m-%d %H:%M:%S")

        now = datetime.utcnow() + timedelta(hours=6)
        diff = now - dt
        seconds = int(diff.total_seconds())

        if seconds < 0:
            return "Just now"

        if seconds < 60:
            return f"{seconds} seconds ago" if seconds > 1 else "1 second ago"
        elif seconds < 3600:
            m = seconds // 60
            return f"{m} minutes ago" if m > 1 else "1 minute ago"
        elif seconds < 86400:
            h = seconds // 3600
            return f"{h} hours ago" if h > 1 else "1 hour ago"
        else:
            d = seconds // 86400
            return f"{d} days ago" if d > 1 else "1 day ago"
    except Exception as e:
        print(f"Time Parse Error: {e}")
        pass

    return val_str

def get_turso_http_url():
    if not TURSO_URL:
        return ""
    url = TURSO_URL.replace("libsql://", "https://")
    if not url.startswith("https://"):
        url = "https://" + url
    return url.rstrip('/') + "/v2/pipeline"

def execute_turso_query(stmt, args=None):
    turso_endpoint = get_turso_http_url()
    if not turso_endpoint or not TURSO_TOKEN:
        return None

    headers = {
        "Authorization": f"Bearer {TURSO_TOKEN}",
        "Content-Type": "application/json"
    }

    formatted_args = []
    if args:
        for arg in args:
            if isinstance(arg, float):
                formatted_args.append({"type": "float", "value": arg})
            elif isinstance(arg, int):
                formatted_args.append({"type": "integer", "value": str(arg)})
            elif arg is None:
                formatted_args.append({"type": "null"})
            else:
                formatted_args.append({"type": "text", "value": str(arg)})

    payload = {
        "requests": [
            {
                "type": "execute",
                "stmt": {
                    "sql": stmt,
                    "args": formatted_args
                }
            },
            {"type": "close"}
        ]
    }

    try:
        res = requests.post(turso_endpoint, json=payload, headers=headers, timeout=10)
        if res.status_code == 200:
            data = res.json()
            results = data.get("results", [])
            if results and results[0].get("type") == "ok":
                return results[0].get("response", {}).get("result", {})
    except Exception as e:
        print(f"Turso HTTP Query Error: {e}")
    return None

