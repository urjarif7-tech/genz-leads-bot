# ---------- ইউজার-ভিত্তিক lock, hold আর atomic charge ----------
_user_locks = {}
_user_locks_guard = threading.Lock()

def user_lock(uid):
    """একই ইউজারের ব্যালেন্স পড়া-বদলানো-সেভ করা একসাথে দুটো থ্রেডে চলতে দেয় না।"""
    key = str(uid).strip()
    with _user_locks_guard:
        lock = _user_locks.get(key)
        if lock is None:
            lock = threading.RLock()
            _user_locks[key] = lock
    return lock

held_amounts = defaultdict(float)   # uid -> SMS এর অপেক্ষায় থাকা নম্বরের জন্য আটকে রাখা টাকা

def reserve_hold(uid, amount):
    """True = আটকানো গেছে, False = ব্যালেন্স কম, None = ডাটাবেস error"""
    key = str(uid).strip()
    with user_lock(key):
        u = get_user_db_strict(key)
        if u is None:
            return None
        if u['balance'] - held_amounts[key] < amount - 1e-9:
            return False
        held_amounts[key] += amount
        return True

def release_hold(uid, amount):
    key = str(uid).strip()
    with user_lock(key):
        held_amounts[key] = max(0.0, held_amounts[key] - amount)

def charge_user(uid, cost, item_label, quantity=1, force=False):
    """ব্যালেন্স কেটে purchase লগ লেখে (atomic)। কেনাকাটা due এ যোগ হয় না।
    সফল হলে নতুন ব্যালেন্স, ব্যালেন্স কম হলে False, ডাটাবেস error হলে None।"""
    key = str(uid).strip()
    with user_lock(key):
        u = get_user_db_strict(key)
        if u is None:
            return None
        if not force and (u['balance'] - held_amounts.get(key, 0.0)) < cost - 1e-9:
            return False

        u['balance'] -= cost
        u['spend'] += cost

        bd_time = bd_now()
        bd_date_str = bd_time.strftime("%Y-%m-%d")
        u['purchases'].insert(0, {
            'date': bd_date_str,
            'time': bd_time.strftime("%I:%M %p").lower(),
            'state': item_label,
            'quantity': quantity,
            'cost': cost
        })
        u['purchases'] = u['purchases'][:PURCHASE_HISTORY_LIMIT]

        if not save_user_db(key, u):
            return None
        return u['balance']

