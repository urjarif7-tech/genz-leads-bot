def track_activity(user):
    """সবসময় False রিটার্ন করে, তাই অন্য হ্যান্ডলারে কোনো প্রভাব পড়ে না।"""
    try:
        uid = str(user.id)
        now = int(time.time())
        if now - _last_touch.get(uid, 0) >= 10:
            _last_touch[uid] = now
            name = f"{user.first_name or ''} {user.last_name or ''}".strip() or "Unknown"
            threading.Thread(target=_write_activity, args=(uid, name, now), daemon=True).start()
    except Exception as e:
        print(f"Track activity error: {e}")
    return False

