BROADCAST_STATE_TIMEOUT = 10 * 60   # ১০ মিনিটের মধ্যে মেসেজ না লিখলে বাতিল
BROADCAST_CONTENT_TYPES = ['text', 'photo', 'video', 'document', 'audio', 'voice', 'animation']
broadcast_states = {}               # ADMIN_ID -> {'target': 'all' | user_id, 'prompt_id': message_id, 'ts': time}

def is_broadcast_waiting():
    st = broadcast_states.get(ADMIN_ID)
    if not st:
        return False
    if time.time() - st['ts'] > BROADCAST_STATE_TIMEOUT:
        broadcast_states.pop(ADMIN_ID, None)
        return False
    return True

def send_broadcast_to(uid, from_chat_id, msg):
    """একজনকে মেসেজ পাঠায়। সফল হলে True, না হলে False (যেমন ইউজার বট ব্লক করলে)।"""
    for attempt in range(2):
        try:
            if hasattr(bot, 'copy_message'):
                bot.copy_message(int(uid), from_chat_id, msg.message_id)
            elif msg.content_type == 'text':
                bot.send_message(int(uid), msg.text)
            else:
                return False
            try:
                save_broadcast(uid, msg)
            except Exception as se:
                print(f"Save broadcast error: {se}")
            return True
        except Exception as e:
            if '429' in str(e) and attempt == 0:
                wait = 5
                try:
                    wait = int(e.result_json['parameters']['retry_after']) + 1
                except Exception:
                    pass
                time.sleep(wait)
                continue
            print(f"Broadcast send error to {uid}: {e}")
            return False
    return False

def run_broadcast_all(recipients, admin_chat_id, msg):
    sent = 0
    failed = 0
    for uid in recipients:
        if send_broadcast_to(uid, admin_chat_id, msg):
            sent += 1
        else:
            failed += 1
        time.sleep(0.05)   # Telegram limit (প্রায় ৩০ মেসেজ/সেকেন্ড) এর নিচে থাকার জন্য
    try:
        bot.send_message(
            admin_chat_id,
            f"📢 Broadcast finished.\n\n✅ Sent: {sent}\n❌ Failed: {failed}"
        )
    except Exception:
        pass

