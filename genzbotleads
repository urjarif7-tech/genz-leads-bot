        return "📢 <b>BROADCASTS</b>\n\n❌ No broadcasts yet.", markup

    entries = [_bc_entry(int(ts or 0), ctype, body) for ts, ctype, body in rows]
    max_pages = ADMIN_INBOX_MAX_PAGES if str(uid) == str(ADMIN_ID) else None
    pages, _ = _bc_pack(entries, max_pages)

    total = len(pages)
    page = max(1, min(page, total))
    text = f"📢 <b>BROADCASTS</b> (Page {page}/{total})\n\n" + "\n──────────────────\n".join(pages[page - 1])

    nav = []
    if page > 1:
