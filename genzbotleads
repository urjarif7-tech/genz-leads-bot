            session_id = random.randint(100000, 999999)
            username = f"leadsbot07-zone-custom-region-{state_code}-session-{session_id}"
            password = "123456bot"
            host = "global.rotip.711proxy.com"
            port = "20000"
            proxy_urls_list.append(f"http://{username}:{password}@{host}:{port}")

    uid = str(call.from_user.id)
    u_data = get_user_db(uid)
