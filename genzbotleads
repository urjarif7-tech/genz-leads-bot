@bot.message_handler(commands=['start'])
def send_welcome(message):
    user = message.from_user
    active_messages.pop(message.chat.id, None)

    if is_approved(user.id):
        welcome_text, markup = build_welcome_dashboard(user.first_name or "User", user.id)
        bot.send_message(message.chat.id, welcome_text, parse_mode='Markdown', reply_markup=markup)
        return

    acc = get_access(user.id)
    now = int(time.time())

    if acc['status'] == 'error':
        bot.send_message(message.chat.id, "⚠️ Something went wrong. Please try again later.")
        return

    if acc['status'] == 'rejected' and now < acc['wait_until']:
        bot.send_message(
            message.chat.id,
            f"🚫 Your request was not approved by admin.\nTry again after {fmt_remaining(acc['wait_until'] - now)}."
        )
        return

    if acc['status'] == 'pending' and now < acc['wait_until']:
        bot.send_message(
            message.chat.id,
            f"⏳ Your request is already sent to the admin.\nYou can send a new request after {fmt_remaining(acc['wait_until'] - now)}."
        )
        return

    # status none, অথবা cooldown শেষ -> নতুন request
    send_access_request(user)

