    )

# Callback Handler for Pagination & Refresh
@bot.callback_query_handler(func=lambda call: call.data.startswith("page_"))
def handle_pagination(call):
    page = int(call.data.split("_")[1])
    leads = fetch_api_leads()
    
    if not leads:
        bot.answer_callback_query(call.id, "No leads available.")
        bot.send_message(call.message.chat.id, "❌ No live leads found at the moment.")
        return

    text, total_pages = get_lead_page_text(leads, page=page, per_page=3)
    markup = build_pagination_keyboard(page, total_pages)
    
    bot.answer_callback_query(call.id, f"Loaded Page {page}")
    
    # Try updating message text, if it fails then send new message
    try:
        bot.edit_message_text(
            text, 
            call.message.chat.id, 
            call.message.message_id, 
            parse_mode="Markdown", 
            reply_markup=markup
        )
    except Exception:
        bot.send_message(
            call.message.chat.id,
            text,
            parse_mode="Markdown",
            reply_markup=markup
        )

# Background Auto Loop for New Leads Notification
def fetch_and_send_leads():
    leads = fetch_api_leads()
    if leads:
        for lead in reversed(leads):
            lead_id = lead.get('id')
            
            if lead_id and lead_id not in seen_lead_ids:
                offer_name = lead.get('offer_name', 'N/A')
                provider = lead.get('provider', 'N/A')
                points = lead.get('points', '0')
                user_id = lead.get('user_id', 'N/A')
                
                msg = (
                    f"🎯 **New Lead Completed!**\n\n"
                    f"👤 **User ID:** `{user_id}`\n"
                    f"📌 **Offer:** {offer_name}\n"
                    f"🌐 **Provider:** {provider}\n"
                    f"💰 **Reward:** {points} Points\n"
                )
                
                bot.send_message(CHAT_ID, msg, parse_mode="Markdown")
                seen_lead_ids.add(lead_id)

def auto_loop():
    while True:
        fetch_and_send_leads()
        time.sleep(15)

def run_bot():
    print("Bot polling started...")
    bot.infinity_polling(timeout=10, long_polling_timeout=5)

if __name__ == "__main__":
    t1 = Thread(target=auto_loop)
    t1.daemon = True
    t1.start()

    t2 = Thread(target=run_bot)
    t2.daemon = True
    t2.start()
    
    run_flask()
