# ==================== ADMIN: /allchat (ইউজাররা কে কী লিখছে) ====================
import queue

CHATLOG_MAX_PAGES = 5            # সর্বোচ্চ ৫ পেজ, এর বেশি কোথাও সেভ থাকে না
CHATLOG_PER_PAGE = 6             # এক পেজে সর্বোচ্চ ৬টা এন্ট্রি
CHATLOG_PAGE_BUDGET = 3400       # এক পেজের লেখার সীমা (Telegram এর ৪০৯৬ অক্ষরের সীমার ভেতরে থাকার জন্য)
CHATLOG_CHUNK = 2600             # খুব লম্বা মেসেজ এর চেয়ে বড় হলে একাধিক অংশে ভেঙে দেখানো হয়
CHATLOG_LOAD_LIMIT = 80
CHATLOG_SEPARATOR = "\n\n┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄\n\n"

db_run('''
    CREATE TABLE IF NOT EXISTS chatlog (
        id INTEGER PRIMARY KEY,
        ts INTEGER,
        user_id TEXT,
        name TEXT,
        text TEXT
    )
''')

chatlog_lock = threading.RLock()
chatlog_rows = []            # নতুন আগে: {'id','ts','uid','name','text'}
chatlog_loaded = False
chatlog_retry_at = 0
chatlog_last_id = 0
chatlog_queue = queue.Queue()
_chatlog_worker_started = False

def _chatlog_chunks(text):
    """লম্বা টেক্সট ভেঙে Telegram এর সীমার ভেতরের অংশে ভাগ করে (কোনো লেখা বাদ যায় না)।"""
    text = text or ''
    parts = []
    i = 0
    while True:
        piece = text[i:i + 1500]
        while len(html.escape(piece, quote=False)) > CHATLOG_CHUNK and len(piece) > 1:
            piece = piece[:int(len(piece) * 0.8)]
        parts.append(piece)
        i += len(piece)
        if i >= len(text):
            break
    return parts

def _chat_time_str(ts):
    return (datetime.utcfromtimestamp(int(ts)) + timedelta(hours=6)).strftime("%d %b %Y, %I:%M %p")

def _chatlog_entries_for_row(row):
    parts = _chatlog_chunks(row['text'])
    entries = []
    for idx, piece in enumerate(parts, start=1):
        head = (
            f"👤 <b>{html.escape(row['name'])}</b>  •  🆔 <code>{html.escape(str(row['uid']))}</code>\n"
            f"🕒 {_chat_time_str(row['ts'])}"
        )
        if len(parts) > 1:
            head += f"  •  ✂️ {idx}/{len(parts)}"
        entries.append(f"{head}\n💬 {html.escape(piece, quote=False)}")
    return entries

def _chatlog_layout(rows):
    """নতুন থেকে পুরনো ক্রমে পেজ বানায়। ৫ পেজে যতটা ধরে ততটাই রাখে। (pages, রাখা সারির সংখ্যা)"""
    pages = []
    cur = []
    cur_len = 0
    kept = 0
    for row in rows:
        entries = _chatlog_entries_for_row(row)
        t_pages = [list(p) for p in pages]
        t_cur = list(cur)
        t_len = cur_len
        for e in entries:
            cost = len(e) + len(CHATLOG_SEPARATOR)
            if t_cur and (len(t_cur) >= CHATLOG_PER_PAGE or t_len + cost > CHATLOG_PAGE_BUDGET):
                t_pages.append(t_cur)
                t_cur, t_len = [], 0
            t_cur.append(e)
            t_len += cost
        if len(t_pages) + (1 if t_cur else 0) > CHATLOG_MAX_PAGES:
            break
        pages, cur, cur_len = t_pages, t_cur, t_len
        kept += 1
    if cur:
        pages.append(cur)
    return pages, kept

def _chatlog_trim_cache():
    """৫ পেজের বাইরের পুরনো সারি বাদ দেয়। বাদ গেলে ডাটাবেস থেকে মোছার সীমা (cutoff id) ফেরত দেয়।"""
    pages, kept = _chatlog_layout(chatlog_rows)
    if kept < len(chatlog_rows) and kept > 0:
        cutoff = chatlog_rows[kept - 1]['id']
        del chatlog_rows[kept:]
        return cutoff
    return None

def _chatlog_ensure_loaded():
    global chatlog_loaded, chatlog_retry_at, chatlog_last_id
    if chatlog_loaded or time.time() < chatlog_retry_at:
        return
    rows = db_run(f"SELECT id, ts, user_id, name, text FROM chatlog ORDER BY id DESC LIMIT {CHATLOG_LOAD_LIMIT}")
    if rows is None:
        chatlog_retry_at = time.time() + 30   # ডাটাবেস সমস্যা: ৩০ সেকেন্ড পর আবার চেষ্টা
        return
    loaded = [{'id': int(r[0]), 'ts': int(r[1] or 0), 'uid': r[2] or '', 'name': r[3] or 'Unknown', 'text': r[4] or ''}
              for r in rows]
    known = {r['id'] for r in chatlog_rows}
    merged = chatlog_rows + [r for r in loaded if r['id'] not in known]
    merged.sort(key=lambda r: r['id'], reverse=True)
    chatlog_rows[:] = merged
    if chatlog_rows:
        chatlog_last_id = max(chatlog_last_id, chatlog_rows[0]['id'])
    chatlog_loaded = True
    cutoff = _chatlog_trim_cache()
    if cutoff:
        chatlog_queue.put(('trim', cutoff))
        _chatlog_start_worker()

def _chatlog_process(item):
    try:
        if item[0] == 'insert':
            e = item[1]
            db_run("INSERT INTO chatlog (id, ts, user_id, name, text) VALUES (?, ?, ?, ?, ?)",
                   [e['id'], e['ts'], str(e['uid']), e['name'], e['text']])
        elif item[0] == 'trim':
            db_run("DELETE FROM chatlog WHERE id < ?", [item[1]])
        elif item[0] == 'delete_user':
            db_run("DELETE FROM chatlog WHERE user_id = ?", [item[1]])
    except Exception as ex:
        print(f"Chatlog DB error: {ex}")

def _chatlog_worker():
    while True:
        item = chatlog_queue.get()
        _chatlog_process(item)

def _chatlog_start_worker():
    global _chatlog_worker_started
    if not _chatlog_worker_started:
        _chatlog_worker_started = True
        threading.Thread(target=_chatlog_worker, daemon=True).start()

def chatlog_add(user, text):
    global chatlog_last_id
    name = f"{user.first_name or ''} {user.last_name or ''}".strip() or "Unknown"
    with chatlog_lock:
        _chatlog_ensure_loaded()
        rid = int(time.time() * 1000000)
        if rid <= chatlog_last_id:
            rid = chatlog_last_id + 1
        chatlog_last_id = rid
        entry = {'id': rid, 'ts': int(time.time()), 'uid': str(user.id), 'name': name, 'text': text}
        chatlog_rows.insert(0, entry)
        cutoff = _chatlog_trim_cache()
    chatlog_queue.put(('insert', entry))
    if cutoff and chatlog_loaded:
        chatlog_queue.put(('trim', cutoff))
    _chatlog_start_worker()

def chatlog_capture(m):
    """প্রতিটা মেসেজে চুপচাপ চলে (ইউজার কিছু টের পায় না)। সবসময় False ফেরত দেয়।
    অ্যাডমিনের মেসেজ আর /start লগ হয় না।"""
    try:
        if m.from_user.id == ADMIN_ID:
            return False
        text = m.text or ''
        if not text.strip():
            return False
        if text.split()[0].split('@')[0].lower() == '/start':
            return False
        chatlog_add(m.from_user, text)
    except Exception as e:
        print(f"Chatlog capture error: {e}")
    return False

def chatlog_forget_user(uid):
    """/resetall এর সময় ওই ইউজারের চ্যাট লগও মুছে দেয়।"""
    key = str(uid).strip()
    with chatlog_lock:
        chatlog_rows[:] = [r for r in chatlog_rows if str(r['uid']) != key]
    chatlog_queue.put(('delete_user', key))
    _chatlog_start_worker()

def build_allchat_page(page):
    with chatlog_lock:
        _chatlog_ensure_loaded()
        pages, _ = _chatlog_layout(chatlog_rows)

    markup = types.InlineKeyboardMarkup()
    total = len(pages)
    if total == 0:
        text = "💬 <b>ALL CHAT</b>\n━━━━━━━━━━━━━━━━━━━━\n\n📭 No messages yet."
        markup.row(types.InlineKeyboardButton("🔄 Refresh", callback_data="acpage_1"))
        markup.add(types.InlineKeyboardButton("❌ Close", callback_data="acclose"))
        return text, markup, 1, 1

    page = max(1, min(int(page), total))
    text = (
        f"💬 <b>ALL CHAT</b>  •  Page {page}/{total}\n"
        "━━━━━━━━━━━━━━━━━━━━\n\n"
        + CHATLOG_SEPARATOR.join(pages[page - 1])
        + "\n\n<i>🔄 Auto-refresh every 30s</i>"
    )

    nav = []
    if page > 1:
        nav.append(types.InlineKeyboardButton("⬅️ Prev", callback_data=f"acpage_{page - 1}"))
    nav.append(types.InlineKeyboardButton("🔄 Refresh", callback_data=f"acpage_{page}"))
    if page < total:
        nav.append(types.InlineKeyboardButton("Next ➡️", callback_data=f"acpage_{page + 1}"))
    markup.row(*nav)
    markup.add(types.InlineKeyboardButton("❌ Close", callback_data="acclose"))
    return text, markup, page, total

# ---------- /allchat পেজ: প্রতি ৩০ সেকেন্ডে auto-refresh ----------
ALLCHAT_AUTO_REFRESH_SECONDS = 30
ALLCHAT_LIVE_TIMEOUT = 30 * 60
allchat_live = {}            # (chat_id, message_id) -> {'page', 'last_touch'}
allchat_live_lock = threading.Lock()

def register_allchat_live(chat_id, message_id, page):
    with allchat_live_lock:
        # প্রতি চ্যাটে শুধু সর্বশেষ /allchat মেসেজ auto-refresh হয়
        for key in [k for k in allchat_live if k[0] == chat_id and k[1] != message_id]:
            allchat_live.pop(key, None)
        allchat_live[(chat_id, message_id)] = {'page': page, 'last_touch': time.time()}

def unregister_allchat_live(chat_id, message_id):
    with allchat_live_lock:
        allchat_live.pop((chat_id, message_id), None)

def allchat_refresh_once():
    with allchat_live_lock:
        snapshot = list(allchat_live.items())
    now = time.time()
    for key, info in snapshot:
        chat_id, message_id = key
        if now - info['last_touch'] > ALLCHAT_LIVE_TIMEOUT:
            unregister_allchat_live(chat_id, message_id)
            continue
        text, markup, page, _ = build_allchat_page(info['page'])
        with allchat_live_lock:
            cur = allchat_live.get(key)
            if not cur:
                continue
            cur['page'] = page
        try:
            bot.edit_message_text(text, chat_id=chat_id, message_id=message_id,
                                  parse_mode='HTML', reply_markup=markup)
        except Exception as e:
            err = str(e).lower()
            if 'not modified' in err:
                pass
            elif 'not found' in err or "can't be edited" in err or 'chat not found' in err:
                unregister_allchat_live(chat_id, message_id)
            else:
                print(f"Allchat auto-refresh error: {e}")

def allchat_auto_refresh_loop():
    while True:
        time.sleep(ALLCHAT_AUTO_REFRESH_SECONDS)
        try:
            allchat_refresh_once()
        except Exception as e:
            print(f"Allchat refresh loop error: {e}")

@bot.message_handler(commands=['allchat'])
def handle_allchat_cmd(message):
    if message.from_user.id != ADMIN_ID:
        bot.reply_to(message, "❌ You are not authorized.")
        return
    text, markup, page, _ = build_allchat_page(1)
    sent = bot.send_message(message.chat.id, text, parse_mode='HTML', reply_markup=markup)
    register_allchat_live(message.chat.id, sent.message_id, page)

@bot.callback_query_handler(func=lambda call: call.data.startswith('acpage_'))
def handle_allchat_pagination(call):
    if call.from_user.id != ADMIN_ID:
        bot.answer_callback_query(call.id, text="Unauthorized!", show_alert=True)
        return
    try:
        req_page = int(call.data.split('_')[1])
    except Exception:
        req_page = 1
    text, markup, page, _ = build_allchat_page(req_page)
    try:
        bot.edit_message_text(text, chat_id=call.message.chat.id, message_id=call.message.message_id,
                              parse_mode='HTML', reply_markup=markup)
        bot.answer_callback_query(call.id)
    except Exception as e:
        if 'not modified' in str(e).lower():
            bot.answer_callback_query(call.id, text="Already up to date.")
        else:
            bot.answer_callback_query(call.id)
    register_allchat_live(call.message.chat.id, call.message.message_id, page)

@bot.callback_query_handler(func=lambda call: call.data == 'acclose')
def handle_allchat_close(call):
    if call.from_user.id != ADMIN_ID:
