@bot.callback_query_handler(func=lambda call: call.data.startswith('historypage_') or call.data == 'user_history')
def handle_user_history(call):
    if call.data == 'user_history':
        page = 1
    else:
        page = int(call.data.split('_')[1])
        
    u_data = get_user_db(call.from_user.id)
    history_list = u_data['purchases']
    
    if not history_list:
        text = "📜 **PURCHASE HISTORY**\n\n❌ আপনি এখনো কোনো প্রক্সি কেনেননি।"
        markup = types.InlineKeyboardMarkup()
        markup.add(types.InlineKeyboardButton("🔙 Back", callback_data="go_welcome"))
    else:
        items_per_page = 5
        total_items = len(history_list)
        total_pages = min((total_items + items_per_page - 1) // items_per_page, 5)
        page = max(1, min(page, total_pages))

        start_idx = (page - 1) * items_per_page
        end_idx = start_idx + items_per_page
        page_items = history_list[start_idx:end_idx]

        text = f"📜 **PURCHASE HISTORY (Page {page}/{total_pages})**\n\n"
        for item in page_items:
            text += (
                f"Date : {item.get('date', 'N/A')}\n"
                f"Time : {item.get('time', 'N/A')}\n"
                f"State : {item.get('state', 'N/A')}\n"
                f"Quantity : {item.get('quantity', 1)}    Cost : {item.get('cost', 0)} TK\n"
                f"----------------------------------------\n"
            )

        total_spend = sum(float(item.get('cost', 0.0)) for item in history_list)
        text += f"\nTotal Spend : {total_spend} TK"

        markup = types.InlineKeyboardMarkup()
        markup.add(types.InlineKeyboardButton("🔄 Refresh", callback_data=f"historypage_{page}"))

        nav_buttons = []
        if page > 1:
            nav_buttons.append(types.InlineKeyboardButton("⬅️ Prev", callback_data=f"historypage_{page - 1}"))
        if page < total_pages:
            nav_buttons.append(types.InlineKeyboardButton("➡️ Next", callback_data=f"historypage_{page + 1}"))

        if nav_buttons:
            markup.row(*nav_buttons)

        markup.add(types.InlineKeyboardButton("🔙 Back", callback_data="go_welcome"))

    try:
        bot.edit_message_text(
            text, 
            chat_id=call.message.chat.id, 
            message_id=call.message.message_id, 
            parse_mode='Markdown', 
            reply_markup=markup
        )
        bot.answer_callback_query(call.id)
    except Exception:
        bot.answer_callback_query(call.id)

