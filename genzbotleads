def fmt_amt(v):
    v = float(v)
    return str(int(v)) if v.is_integer() else f"{v:.2f}".rstrip('0').rstrip('.')

def parse_amount(text):
    try:
        t = (text or '').replace(',', '').strip().lower()
        if t.endswith('tk'):
            t = t[:-2].strip()
        v = float(t)
    except Exception:
        return None
    if not math.isfinite(v) or v <= 0 or v > 10000000:
        return None
    return v

def fmt_bd_time(ts):
    return (datetime.utcfromtimestamp(int(ts)) + timedelta(hours=6)).strftime("%Y-%m-%d %I:%M %p")

