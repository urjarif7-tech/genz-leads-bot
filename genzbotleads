import uuid

active_orders = {}    # order_id -> {'uid', 'price', 'num', 'service'}  (SMS এর অপেক্ষায় থাকা নম্বর)
block_tokens = {}     # ছোট token -> {'order_id', 'num', 'uid'}  (callback_data ৬৪ বাইটের সীমার জন্য)
orders_lock = threading.Lock()
busy_users = set()    # একই ইউজারের দুইবার চাপা (double-click) আটকাতে

def acquire_busy(uid):
    with orders_lock:
        if uid in busy_users:
            return False
        busy_users.add(uid)
        return True

def release_busy(uid):
    with orders_lock:
        busy_users.discard(uid)

def pop_active_order(order_id):
    with orders_lock:
        return active_orders.pop(order_id, None)

def get_available_balance(uid):
    return get_effective_balance(uid) - held_amounts.get(str(uid).strip(), 0.0)

def get_durian_number_api(service_name, country_code):
    """সফল হলে (number, order_id), না হলে (None, None)। আর কখনো নকল নম্বর বানায় না।"""
    try:
        url = f"{DURIAN_BASE_URL}/get_number?apikey={DURIANRCS_API_KEY}&service={service_name.lower()}&country={country_code.lower()}"
        res = requests.get(url, timeout=8)
        if res.status_code == 200:
            data = res.json()
            number = data.get('number')
            order_id = data.get('id')
            if number and order_id:
                return str(number), str(order_id)
        print(f"Durian get_number failed: HTTP {res.status_code} body={res.text[:200]}")
    except Exception as e:
        print(f"Durian API Error: {e}")
    return None, None

def cancel_durian_number_api(order_id):
    try:
        url = f"{DURIAN_BASE_URL}/cancel_number?apikey={DURIANRCS_API_KEY}&id={order_id}"
        requests.get(url, timeout=3)
    except Exception:
        pass

def number_service_markup(country_code, service_name):
    markup = types.InlineKeyboardMarkup()
