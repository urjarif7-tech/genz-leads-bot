def get_all_users_from_db():
    if TURSO_URL and TURSO_TOKEN:
        res = execute_turso_query("SELECT telegram_id, full_name, last_active FROM users")
        users = []
        if res and res.get("rows"):
            for row in res["rows"]:
                t_id = row[0].get("value")
                f_name = row[1].get("value", "Unknown")
                l_act = float(row[2].get("value", 0.0) or 0.0)
                users.append({'telegram_id': t_id, 'full_name': f_name, 'last_active': l_act})
        return users
    else:
        conn = sqlite3.connect(DB_FILE)
        cursor = conn.cursor()
        cursor.execute("SELECT telegram_id, full_name, last_active FROM users")
        rows = cursor.fetchall()
        conn.close()
        users = []
        for r in rows:
            users.append({'telegram_id': r[0], 'full_name': r[1] or "Unknown", 'last_active': float(r[2] or 0.0)})
        return users

def format_time_diff(last_active_timestamp):
    if not last_active_timestamp:
        return "Never"
    diff = int(time.time() - last_active_timestamp)
    if diff < 60:
        return f"{diff} seconds ago"
    elif diff < 3600:
        m = diff // 60
        return f"{m} minutes ago"
    elif diff < 86400:
        h = diff // 3600
        return f"{h} hours ago"
    else:
        d = diff // 86400
        return f"{d} days ago"

