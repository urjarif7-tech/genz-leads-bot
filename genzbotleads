def get_durian_number_api(service_name, country_code):
    try:
        url = f"{DURIAN_BASE_URL}/get_number?apikey={DURIANRCS_API_KEY}&service={service_name.lower()}&country={country_code.lower()}"
        res = requests.get(url, timeout=5)
        if res.status_code == 200:
            data = res.json()
            if data.get('status') == 'success' or data.get('number'):
                return data.get('number'), data.get('id')
    except Exception as e:
        print(f"Durian API Error: {e}")
    mock_num = str(random.randint(3000000000, 9999999999))
    return mock_num, f"id_{mock_num}"

