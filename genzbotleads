def fit_text(body, limit=1200, max_escaped=3000):
    body = body or ''
    cut = len(body) > limit
    body = body[:limit]
    esc = html.escape(body, quote=False)
    while len(esc) > max_escaped:
        body = body[:int(len(body) * 0.8)]
        esc = html.escape(body, quote=False)
        cut = True
    return esc + ('…' if cut else '')

def build_user_broadcasts_page(uid, page):
