@bot.message_handler(commands=['addbalance'])
def handle_add_balance(message):
    if message.from_user.id != ADMIN_ID:
        bot.reply_to(message, "❌ You are not authorized to use this command.")
        return
    try:
        args = message.text.split()
        target_user = int(args[1])
        amount = float(args[2])
        
        USER_BALANCES[target_user] = USER_BALANCES.get(target_user, 0.0) + amount
        
        try:
            bot.send_message(
                target_user, 
                f"✅ **Congratulations!** Your balance request of `{amount} TK` has been **Approved** by Admin.\nYour current balance is updated!", 
                parse_mode='Markdown'
            )
        except Exception:
            pass

        bot.reply_to(message, f"✅ Successfully added `{amount} TK` balance for User ID `{target_user}`!", parse_mode='Markdown')
    except Exception:
        bot.reply_to(message, "⚠️ Usage: `/addbalance <user_id> <amount>`\nExample: `/addbalance 5763930051 100`", parse_mode='Markdown')

@bot.message_handler(commands=['markpaid'])
def handle_mark_paid(message):
    if message.from_user.id != ADMIN_ID:
        return
    try:
        args = message.text.split()
        target_user = int(args[1])
        amount = float(args[2])
        
        USER_PAID[target_user] = USER_PAID.get(target_user, 0.0) + amount
        if target_user in USER_DUES:
            USER_DUES[target_user] = max(0.0, USER_DUES[target_user] - amount)
        
        try:
            bot.send_message(target_user, f"✅ **Good News!** Your payment of `{amount} TK` has been marked as **Paid** by Admin.", parse_mode='Markdown')
        except Exception:
            pass

        bot.reply_to(message, f"✅ Successfully marked `{amount} TK` as **PAID** for user ID `{target_user}`!", parse_mode='Markdown')
    except Exception:
        bot.reply_to(message, "⚠️ Usage: `/markpaid <user_id> <amount>`\nExample: `/markpaid 5763930051 100`", parse_mode='Markdown')

