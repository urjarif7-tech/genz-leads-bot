        return

    msgadmin_states.pop(uid, None)
    if state:
        try:
            bot.edit_message_reply_markup(state['chat_id'], state['msg_id'], reply_markup=None)
        except Exception:
            pass

    save_user_message_for_admin(uid, user_full_name(message.from_user), text)

    back = types.InlineKeyboardMarkup()
    back.add(types.InlineKeyboardButton("🔙 Back", callback_data="go_welcome"))
    bot.reply_to(message, "✅ Your message has been sent to the admin.", reply_markup=back)
