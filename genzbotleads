@bot.callback_query_handler(func=lambda call: call.data.startswith('buy_711_'))
def handle_buy_711_confirm(call):
    parts = call.data.split('_')
    state_code = parts[2]
    state_name = state_code.capitalize()
    quantity = int(parts[3])
    cost = quantity * 5.0

    stats = fetch_user_stats(call.from_user.id)
    balance = stats.get('balance', 0.0) if stats else 0.0

    if balance < cost:
        bot.answer_callback_query(call.id, text=f"❌ Insufficient balance! Required: {cost} TK", show_alert=True)
        return

    proxy_str = f"proxy.711proxy.com:8080:user_{call.from_user.id}:pass123"
    try:
        res = requests.get(PROXY_711_URL, timeout=10)
        if res.status_code == 200:
            text_data = res.text.strip()
            if text_data:
                proxy_str = text_data.split('\n')[0].strip()
    except Exception as e:
        print(f"711 Proxy API Error: {e}")

    admin_alert = (
        f"🛒 **NEW PROXY PURCHASE (DUE)!**\n\n"
        f"👤 User: {call.from_user.first_name} (`{call.from_user.id}`)\n"
        f"🌐 Provider: 711 Proxy ({state_name})\n"
        f"📦 Quantity: {quantity}x\n"
        f"🔴 Status: Due\n"
        f"💵 Amount: `{cost} TK`\n"
        f"📍 Proxy: `{proxy_str}`"
    )
    try:
        bot.send_message(ADMIN_ID, admin_alert, parse_mode='Markdown')
    except Exception:
        pass

    qr = qrcode.QRCode(version=1, box_size=10, border=4)
    qr.add_data(proxy_str)
    qr.make(fit=True)
    img = qr.make_image(fill_color="black", back_color="white")

    img_byte_arr = io.BytesIO()
    img.save(img_byte_arr, format='PNG')
    img_byte_arr.seek(0)

    caption = (
        f"✅ **PROXY VERIFIED & ADDED TO DUE ({quantity}/{quantity})**\n\n"
        f"🔴 Status: Due ({cost} TK)\n"
        f"🌐 711 Proxy ({state_name}, United States)\n"
        f"📍 Proxy: `{proxy_str}`"
    )

    bot.delete_message(call.message.chat.id, call.message.message_id)
    bot.send_photo(call.message.chat.id, photo=img_byte_arr, caption=caption, parse_mode='Markdown')

