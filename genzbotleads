    markup = types.InlineKeyboardMarkup()

    if rows is None:
        markup.add(types.InlineKeyboardButton("🔙 Back", callback_data="menu_profile"))
        return "📢 <b>BROADCASTS</b>\n\n⚠️ Something went wrong. Please try again.", markup
    if not rows:
        markup.add(types.InlineKeyboardButton("🔙 Back", callback_data="menu_profile"))
        return "📢 <b>BROADCASTS</b>\n\n❌ No broadcasts yet.", markup

    entries = []
    for ts, ctype, body in rows:
        head = f"🕒 {fmt_bd_time(ts)}"
        label = BC_LABELS.get(ctype)
        if label:
            head += f"\n[{label}]"
        text_part = fit_text(body)
        entries.append(head + ("\n" + text_part if text_part else ""))

    # প্রতি পেজে সর্বোচ্চ ৫টা, আর Telegram এর লেখার সীমা পার না করে
    pages = []
    cur = []
    cur_len = 0
    for e in entries:
        if cur and (len(cur) >= 5 or cur_len + len(e) > 3400):
            pages.append(cur)
            cur, cur_len = [], 0
        cur.append(e)
        cur_len += len(e)
    if cur:
        pages.append(cur)

    total = len(pages)
    page = max(1, min(page, total))
    text = f"📢 <b>BROADCASTS</b> (Page {page}/{total})\n\n" + "\n──────────────────\n".join(pages[page - 1])

    nav = []
    if page > 1:
        nav.append(types.InlineKeyboardButton("⬅️ Prev", callback_data=f"userbc_{page - 1}"))
    if page < total:
        nav.append(types.InlineKeyboardButton("Next ➡️", callback_data=f"userbc_{page + 1}"))
    if nav:
        markup.row(*nav)
    markup.add(types.InlineKeyboardButton("🔙 Back", callback_data="menu_profile"))
    return text, markup

@bot.callback_query_handler(func=lambda call: call.data.startswith('userbc_'))
def handle_user_broadcasts(call):
    try:
        page = int(call.data.split('_')[1])
    except Exception:
        page = 1
    text, markup = build_user_broadcasts_page(call.from_user.id, page)
    show_page(call, text, markup)
    bot.answer_callback_query(call.id)
