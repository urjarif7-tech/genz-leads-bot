def get_user_db(telegram_id):
    client = get_db_connection()
    t_id = str(telegram_id).strip()
    
    if TURSO_URL and TURSO_TOKEN:
        rs = client.execute("SELECT balance, spend, due, paid, purchases, due_logs FROM users WHERE telegram_id = ?", [t_id])
        row = rs.rows[0] if rs.rows else None
        client.close()
    else:
        cursor = client.cursor()
        cursor.execute('SELECT balance, spend, due, paid, purchases, due_logs FROM users WHERE telegram_id = ?', (t_id,))
        row = cursor.fetchone()
        client.close()

    if row:
        try:
            purchases = json.loads(row[4]) if row[4] else []
        except Exception:
            purchases = []
        try:
            due_logs = json.loads(row[5]) if row[5] else []
        except Exception:
            due_logs = []

        return {
            'balance': float(row[0] or 0.0),
            'spend': float(row[1] or 0.0),
            'due': float(row[2] or 0.0),
            'paid': float(row[3] or 0.0),
            'purchases': purchases,
            'due_logs': due_logs
        }
    else:
        return {
            'balance': 0.0,
            'spend': 0.0,
            'due': 0.0,
            'paid': 0.0,
            'purchases': [],
            'due_logs': []
        }

def save_user_db(telegram_id, data):
    client = get_db_connection()
    t_id = str(telegram_id).strip()
    
    params = [
        t_id,
        float(data.get('balance', 0.0)),
        float(data.get('spend', 0.0)),
        float(data.get('due', 0.0)),
        float(data.get('paid', 0.0)),
        json.dumps(data.get('purchases', [])),
        json.dumps(data.get('due_logs', []))
    ]

    if TURSO_URL and TURSO_TOKEN:
        client.execute('''
            INSERT OR REPLACE INTO users (telegram_id, balance, spend, due, paid, purchases, due_logs)
            VALUES (?, ?, ?, ?, ?, ?, ?)
        ''', params)
        client.close()
    else:
        cursor = client.cursor()
        cursor.execute('''
            INSERT OR REPLACE INTO users (telegram_id, balance, spend, due, paid, purchases, due_logs)
            VALUES (?, ?, ?, ?, ?, ?, ?)
        ''', params)
        client.commit()
        client.close()

