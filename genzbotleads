def poll_durian_sms(chat_id, msg_id, num_str, order_id, service_name, price, country_code, user_id):
    start_time = time.time()
    sms_received = False
    sms_code = None

    while time.time() - start_time < 120:
        time.sleep(5)
        try:
            url = f"{DURIAN_BASE_URL}/get_sms?apikey={DURIANRCS_API_KEY}&id={order_id}"
            res = requests.get(url, timeout=5)
            if res.status_code == 200:
                data = res.json()
                if data.get('status') == 'success' and data.get('code'):
                    sms_received = True
                    sms_code = data.get('code')
                    break
        except Exception:
            pass

    if sms_received:
        uid = str(user_id)
        u_data = get_user_db(uid)
        u_data['balance'] -= price
        u_data['spend'] += price
        u_data['due'] += price

        bd_time = datetime.utcnow() + timedelta(hours=6)
        bd_date_str = bd_time.strftime("%Y-%m-%d")
        
        purchase_log = {
            'date': bd_date_str,
            'time': bd_time.strftime("%I:%M %p").lower(),
            'state': f"📱 {service_name} Number",
            'quantity': 1,
            'cost': price
        }
        u_data['purchases'].insert(0, purchase_log)
        
        u_data['due_logs'].append({
            'date': bd_date_str,
            'price': price,
            'paid': 0.0
        })
        
        save_user_db(uid, u_data)

        rem_bal = get_effective_balance(user_id)
        text = (
            f"✅ **SMS RECEIVED!**\n\n"
            f"Number: `{num_str}`\n"
            f"Service: {service_name}\n"
            f"Code: `{sms_code}`\n\n"
            f"💳 {price} TK deducted\n"
            f"Remaining: {rem_bal} TK"
        )
        markup = types.InlineKeyboardMarkup(row_width=2)
        btn_block = types.InlineKeyboardButton("🚫 Block Number", callback_data=f"numblock_{order_id}_{num_str}")
        btn_again = types.InlineKeyboardButton("🔄 Purchase Again", callback_data=f"numsrv_{country_code}_{service_name}")
        btn_back = types.InlineKeyboardButton("🔙 Back", callback_data="go_welcome")
        markup.add(btn_block, btn_again)
        markup.add(btn_back)

        try:
            bot.edit_message_text(text, chat_id=chat_id, message_id=msg_id, parse_mode='Markdown', reply_markup=markup)
        except Exception:
            pass

        time.sleep(60)
        cancel_durian_number_api(order_id)
        text_blocked = f"🔒 Number `{num_str}` auto-blocked."
        markup_back = types.InlineKeyboardMarkup()
        markup_back.add(types.InlineKeyboardButton("🔙 Back", callback_data="go_welcome"))

        try:
            bot.edit_message_text(text_blocked, chat_id=chat_id, message_id=msg_id, parse_mode='Markdown', reply_markup=markup_back)
        except Exception:
            pass

    else:
        cancel_durian_number_api(order_id)
        text_noblock = (
            f"⏰ **No SMS for {num_str}.**\n"
            f"Number auto-blocked.\n\n"
            f"Buy another number."
        )
        markup = types.InlineKeyboardMarkup(row_width=2)
        b_super = types.InlineKeyboardButton("Super - 10.0 TK", callback_data=f"numsrv_{country_code}_Super")
        b_fetch = types.InlineKeyboardButton("Fetch - 12.0 TK", callback_data=f"numsrv_{country_code}_Fetch")
        b_pogo = types.InlineKeyboardButton("Pogo - 14.0 TK", callback_data=f"numsrv_{country_code}_Pogo")
        b_reco = types.InlineKeyboardButton("Reco - 16.0 TK", callback_data=f"numsrv_{country_code}_Reco")
        b_inbox = types.InlineKeyboardButton("InboxDollar - 14.0 TK", callback_data=f"numsrv_{country_code}_InboxDollar")
        b_copper = types.InlineKeyboardButton("Copper - 20.0 TK", callback_data=f"numsrv_{country_code}_Copper")
        btn_back = types.InlineKeyboardButton("🔙 Back", callback_data="numprov_durian")

        markup.add(b_super, b_fetch)
        markup.add(b_pogo, b_reco)
        markup.add(b_inbox, b_copper)
        markup.add(btn_back)

        try:
            bot.edit_message_text(text_noblock, chat_id=chat_id, message_id=msg_id, parse_mode='Markdown', reply_markup=markup)
        except Exception:
            pass

