    welcome_text, markup = build_welcome_dashboard(call.from_user.first_name or "User", call.message.chat.id)
    
    try:
        bot.edit_message_text(
            chat_id=call.message.chat.id,
            message_id=call.message.message_id,
            text=welcome_text,
            parse_mode='Markdown',
            reply_markup=markup
        )
        bot.answer_callback_query(call.id)
    except Exception:
