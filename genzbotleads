def set_access(uid, status, full_name, wait_until=0):
    db_run(
        "INSERT OR REPLACE INTO access (telegram_id, status, full_name, wait_until) VALUES (?, ?, ?, ?)",
        [str(uid), status, full_name, int(wait_until)]
    )

def get_access(uid):
    uid = str(uid)
    rows = db_run("SELECT status, full_name, wait_until FROM access WHERE telegram_id = ?", [uid])
    if rows is None:
        return {'status': 'error', 'full_name': '', 'wait_until': 0}
    if rows:
        return {'status': rows[0][0], 'full_name': rows[0][1] or '', 'wait_until': int(rows[0][2] or 0)}

    # আগে থেকে যারা users টেবিলে আছে তাদের অটো approved ধরা হবে
    old = db_run("SELECT 1 FROM users WHERE telegram_id = ?", [uid])
    if old:
        set_access(uid, 'approved', '', 0)
        return {'status': 'approved', 'full_name': '', 'wait_until': 0}

    return {'status': 'none', 'full_name': '', 'wait_until': 0}

def is_approved(uid):
    if int(uid) == ADMIN_ID:
        return True
    return get_access(uid)['status'] == 'approved'

def fmt_remaining(seconds):
    seconds = max(0, int(seconds))
    h = seconds // 3600
    m = (seconds % 3600) // 60
    s = seconds % 60
    if h > 0:
        return f"{h}h {m}m"
    if m > 0:
        return f"{m}m {s}s"
    return f"{s}s"

def send_access_request(user):
    uid = str(user.id)
    full_name = f"{user.first_name or ''} {user.last_name or ''}".strip() or "Unknown"
    set_access(uid, 'pending', full_name, int(time.time()) + REQUEST_RESEND_SECONDS)

    text = (
        "📥 <b>NEW USER REQUEST</b>\n\n"
        f"👤 Name: {html.escape(full_name)}\n"
        f"🆔 User ID: <code>{uid}</code>"
    )
    if user.username:
        text += f"\n🔗 Username: @{html.escape(user.username)}"

    markup = types.InlineKeyboardMarkup(row_width=2)
    markup.add(
        types.InlineKeyboardButton("Accept✅", callback_data=f"acc_ok_{uid}"),
        types.InlineKeyboardButton("Cancel🚫", callback_data=f"acc_no_{uid}")
    )
    bot.send_message(ADMIN_ID, text, parse_mode='HTML', reply_markup=markup)
    bot.send_message(user.id, "⏳ Your request has been sent to the admin.")

