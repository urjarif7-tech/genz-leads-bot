def build_lead_message(data):
    leads = data.get('data', [])
    current_page = data.get('current_page', 1)
    last_page = min(data.get('last_page', 1), 5)

    if not leads:
        return "🎯 No Live Leads Found!", None

    message_text = f"🎯 Live Leads List (Page {current_page}/{last_page})\n\n"
    
    for lead in leads:
        user_id = str(lead.get('user_id', 'N/A')).replace('*', '')
        offer_name = str(lead.get('offer_name', 'N/A')).replace('*', '')
        provider = str(lead.get('provider', 'N/A')).replace('*', '')
        points = str(lead.get('points', '0')).replace('*', '')
        time_ago = str(lead.get('time_ago', 'Just now')).replace('*', '')

        message_text += f"👤 User ID: {user_id}\n"
        message_text += f"📌 Offer: {offer_name}\n"
        message_text += f"🌐 Provider: {provider}\n"
        message_text += f"💰 Reward: {points} Points\n"
        message_text += f"⏱️ Time: {time_ago}\n\n"

    markup = types.InlineKeyboardMarkup()
    markup.add(types.InlineKeyboardButton("🔄 Refresh", callback_data=f"page_{current_page}"))

    nav_buttons = []
    if current_page > 1:
        nav_buttons.append(types.InlineKeyboardButton("⬅️ Prev", callback_data=f"page_{current_page - 1}"))
    if current_page < last_page:
        nav_buttons.append(types.InlineKeyboardButton("➡️ Next", callback_data=f"page_{current_page + 1}"))

    if nav_buttons:
        markup.row(*nav_buttons)

    markup.add(types.InlineKeyboardButton("🔙 Back", callback_data="go_welcome"))
    return message_text, markup

def auto_refresh_loop():
    while True:
        time.sleep(15)
        for chat_id, info in list(active_messages.items()):
            msg_id = info.get('message_id')
            current_page = info.get('page', 1)
            
            data = fetch_leads(page=current_page)
            if data:
                msg_text, markup = build_lead_message(data)
                try:
                    bot.edit_message_text(
                        chat_id=chat_id,
                        message_id=msg_id,
                        text=msg_text,
                        reply_markup=markup
                    )
                except Exception:
                    pass

