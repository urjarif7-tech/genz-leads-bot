            except Exception:
                pass
        else:
            bot.send_message(chat_id, text, parse_mode='Markdown')
        return

    items_per_page = 10
    total_items = len(all_users)
    total_pages = (total_items + items_per_page - 1) // items_per_page
    page = max(1, min(page, total_pages))

    start_idx = (page - 1) * items_per_page
