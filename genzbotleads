def fit_text(body, limit=1200, max_escaped=3000):
    body = body or ''
    cut = len(body) > limit
    body = body[:limit]
    esc = html.escape(body, quote=False)
    while len(esc) > max_escaped:
        body = body[:int(len(body) * 0.8)]
        esc = html.escape(body, quote=False)
        cut = True
    return esc + ('…' if cut else '')

def _bc_entry(ts, ctype, body):
    head = f"🕒 {fmt_bd_time(ts)}"
    if ctype == 'user_message':
        try:
            d = json.loads(body or '{}')
            if not isinstance(d, dict):
                d = {}
        except Exception:
            d = {}
        name = html.escape(str(d.get('name') or 'Unknown'))
        uid_s = html.escape(str(d.get('uid') or ''))
        text = fit_text(str(d.get('text') or ''), limit=2500, max_escaped=3000)
        return f"{head}\n📨 <b>{name}</b>  •  🆔 <code>{uid_s}</code>\n💬 {text}"
    label = BC_LABELS.get(ctype)
    if label:
        head += f"\n[{label}]"
    text_part = fit_text(body)
    return head + ("\n" + text_part if text_part else "")

def _bc_pack(entries, max_pages=None):
    """প্রতি পেজে সর্বোচ্চ ৫টা এন্ট্রি আর Telegram এর লেখার সীমা মেনে পেজ বানায়।
    max_pages দিলে ওই পেজে যতটা ধরে ততটাই রাখে। (pages, রাখা এন্ট্রির সংখ্যা)"""
    pages = []
    cur = []
    cur_len = 0
    kept = 0
    for e in entries:
        if cur and (len(cur) >= 5 or cur_len + len(e) > 3400):
            if max_pages and len(pages) + 2 > max_pages:
                break
            pages.append(cur)
            cur, cur_len = [], 0
        cur.append(e)
        cur_len += len(e)
        kept += 1
    if cur:
        pages.append(cur)
    return pages, kept

def build_user_broadcasts_page(uid, page):
    rows = db_run(
        "SELECT ts, content_type, body FROM broadcasts WHERE telegram_id = ? ORDER BY ts DESC, id DESC LIMIT 100",
        [str(uid)]
