import os
import time
from threading import Thread
from flask import Flask
import requests
import telebot

# Render Free Tier Web Server Setup
app = Flask('')

@app.route('/')
def home():
    return "Bot is alive!"

def run():
    port = int(os.environ.get('PORT', 8080))
    app.run(host='0.0.0.0', port=port)

def keep_alive():
    t = Thread(target=run)
    t.daemon = True
    t.start()

# Telegram Configuration
BOT_TOKEN = "8809930723:AAH2LExR_Mkn3Y-PfuojEL8sOQIiQJa0Tsc"
CHAT_ID = 7089010379  # আপনার Personal Chat ID

bot = telebot.TeleBot(BOT_TOKEN)
API_URL = "https://genzreward.com/api/live-leads-bot"

seen_lead_ids = set()

def fetch_and_send_leads():
    try:
        response = requests.get(API_URL, timeout=10)
        if response.status_code == 200:
            json_data = response.json()
            leads = json_data.get('data', [])

            for lead in reversed(leads):
                lead_id = lead.get('id')
                
                if lead_id and lead_id not in seen_lead_ids:
                    offer_name = lead.get('offer_name', 'N/A')
                    provider = lead.get('provider', 'N/A')
                    points = lead.get('points', '0')
                    user_id = lead.get('user_id', 'N/A')
                    
                    msg = (
                        f"🎯 **New Lead Completed!**\n\n"
                        f"👤 **User ID:** `{user_id}`\n"
                        f"📌 **Offer:** {offer_name}\n"
                        f"🌐 **Provider:** {provider}\n"
                        f"💰 **Reward:** {points} Points\n"
                    )
                    
                    bot.send_message(CHAT_ID, msg, parse_mode="Markdown")
                    seen_lead_ids.add(lead_id)

    except Exception as e:
        print(f"Error fetching leads: {e}")

if __name__ == "__main__":
    keep_alive()  # Flask server thread-এ ব্যাকগ্রাউন্ডে চালু হবে
    print("Bot loop started...")
    while True:
        fetch_and_send_leads()
        time.sleep(15)  # প্রতি ১৫ সেকেন্ড পরপর চেক করবে
