# ==================== ADMIN: /userid (ALL USERS + LAST ACTIVE) ====================
USERS_PER_PAGE = 10
ONLINE_WINDOW_SECONDS = 60   # শেষ ১ মিনিটে বট ব্যবহার করলে 🟢, নাহলে ⚪

def fmt_ago(ts):
    if not ts:
        return "N/A"
    seconds = int(time.time()) - int(ts)
    if seconds < 0:
        seconds = 0
    if seconds < 60:
        return f"{seconds} second{'s' if seconds != 1 else ''} ago"
    if seconds < 3600:
        m = seconds // 60
        return f"{m} minute{'s' if m != 1 else ''} ago"
    if seconds < 86400:
        h = seconds // 3600
        return f"{h} hour{'s' if h != 1 else ''} ago"
    d = seconds // 86400
    return f"{d} day{'s' if d != 1 else ''} ago"

_users_cache = []

def get_all_users_sorted():
    """শুধু approved (join করা) ইউজারদের তালিকা। kicked/pending/rejected দেখাবে না।"""
    global _users_cache
    access_rows = db_run("SELECT telegram_id, status, full_name FROM access")
    old_rows = db_run("SELECT telegram_id FROM users")
    act_rows = db_run("SELECT telegram_id, full_name, last_active FROM activity")
    if access_rows is None or old_rows is None or act_rows is None:
        return _users_cache  # ডাটাবেস সাময়িক error হলে আগের তালিকাই দেখাবে

    access_ids = set()
    approved = {}
    for r in access_rows:
        uid = str(r[0])
        access_ids.add(uid)
        if r[1] == 'approved':
            approved[uid] = {'name': r[2] or '', 'last': 0}

    # access টেবিলে নেই কিন্তু users টেবিলে আছে = পুরনো ইউজার (অটো approved)
    for r in old_rows:
        uid = str(r[0])
        if uid not in access_ids:
            approved.setdefault(uid, {'name': '', 'last': 0})

    approved.setdefault(str(ADMIN_ID), {'name': '', 'last': 0})

    for r in act_rows:
        uid = str(r[0])
        if uid in approved:
            if r[1]:
                approved[uid]['name'] = r[1]
            approved[uid]['last'] = int(r[2] or 0)

    items = [(uid, d['name'] or 'Unknown', d['last']) for uid, d in approved.items()]
    items.sort(key=lambda x: x[2], reverse=True)  # সবচেয়ে সাম্প্রতিক active আগে
    _users_cache = items
    return items

def build_users_page(page):
    items = get_all_users_sorted()
    total = len(items)
    total_pages = max(1, (total + USERS_PER_PAGE - 1) // USERS_PER_PAGE)
    page = max(1, min(page, total_pages))

    start = (page - 1) * USERS_PER_PAGE
    page_items = items[start:start + USERS_PER_PAGE]

    now = int(time.time())
    text = f"👥 <b>ALL USERS</b> (Page {page}/{total_pages})\n"
    text += f"Total: {total}\n\n"

    if not page_items:
        text += "❌ No users found."
    for i, (uid, name, last) in enumerate(page_items, start=start + 1):
        icon = "🟢" if last and (now - last) < ONLINE_WINDOW_SECONDS else "⚪"
        text += (
            f"<b>{i}.</b> {icon} {html.escape(name)}\n"
            f"🆔 <code>{uid}</code>\n"
            f"🕒 {fmt_ago(last)}\n\n"
        )

    buttons = []
    if page > 1:
        buttons.append(types.InlineKeyboardButton("⬅️ Prev", callback_data=f"usrpg_{page - 1}"))
    buttons.append(types.InlineKeyboardButton("🔄 Refresh", callback_data=f"usrpg_{page}"))
    if page < total_pages:
        buttons.append(types.InlineKeyboardButton("Next ➡️", callback_data=f"usrpg_{page + 1}"))

    markup = types.InlineKeyboardMarkup()
    markup.row(*buttons)
    return text, markup, page, total_pages

USERID_AUTO_REFRESH_SECONDS = 15
USERID_LIVE_TIMEOUT = 30 * 60   # ৩০ মিনিট কোনো বাটন না চাপলে auto-refresh বন্ধ (Turso/API লোড কমাতে)
userid_live = {}                # (chat_id, message_id) -> {'page': n, 'last_touch': ts}
userid_live_lock = threading.Lock()

def register_userid_live(chat_id, message_id, page):
    with userid_live_lock:
        # প্রতি চ্যাটে শুধু সর্বশেষ /userid মেসেজটাই auto-refresh হবে
        for key in [k for k in userid_live if k[0] == chat_id and k[1] != message_id]:
            userid_live.pop(key, None)
        userid_live[(chat_id, message_id)] = {'page': page, 'last_touch': time.time()}

def userid_auto_refresh_loop():
    while True:
        time.sleep(USERID_AUTO_REFRESH_SECONDS)
        try:
            with userid_live_lock:
                snapshot = list(userid_live.items())
            now = time.time()
            for key, info in snapshot:
                chat_id, message_id = key
                if now - info['last_touch'] > USERID_LIVE_TIMEOUT:
                    with userid_live_lock:
                        userid_live.pop(key, None)
                    continue

                text, markup, page, _ = build_users_page(info['page'])
                try:
                    bot.edit_message_text(text, chat_id=chat_id, message_id=message_id,
                                          parse_mode='HTML', reply_markup=markup)
                except Exception as e:
                    err = str(e).lower()
                    if 'not modified' in err:
                        pass
                    elif 'not found' in err or "can't be edited" in err or 'chat not found' in err:
                        with userid_live_lock:
                            userid_live.pop(key, None)  # মেসেজ ডিলিট হয়ে গেছে
                    else:
                        print(f"Userid auto-refresh error: {e}")

                with userid_live_lock:
                    cur = userid_live.get(key)
                    if cur and cur['page'] == info['page']:
                        cur['page'] = page
        except Exception as e:
            print(f"Userid refresh loop error: {e}")

@bot.message_handler(commands=['userid'])
def handle_userid_cmd(message):
    if message.from_user.id != ADMIN_ID:
        bot.reply_to(message, "❌ You are not authorized.")
        return
