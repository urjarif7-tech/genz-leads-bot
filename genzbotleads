    try:
        clip_api = f"https://webipapi.cliproxy.com/api/getIpInfo?key={CLIPROXY_KEY}&port=443&num={quantity}&country=US&state={state_name}&type=2"
        res = requests.get(clip_api, timeout=5)
        if res.status_code == 200:
            lines = res.text.strip().splitlines()
            for line in lines:
                line_str = line.strip()
                if line_str:
                    parts_ip = line_str.split(':')
                    if len(parts_ip) == 4 and not line_str.startswith("http") and not line_str.startswith("socks"):
                        host, port, username, password = parts_ip
