def fetch_leads(page=1):
    try:
        response = requests.get(f"{API_URL}?page={page}", timeout=10)
        if response.status_code == 200:
            return response.json()
    except Exception as e:
        print(f"Error fetching leads: {e}")
    return None

def fetch_user_stats(telegram_id):
    try:
        response = requests.get(USER_API_URL, params={'telegram_id': telegram_id}, timeout=10)
        if response.status_code == 200:
            return response.json()
    except Exception as e:
        print(f"Error fetching user stats: {e}")
    return None

def get_effective_balance(telegram_id):
    stats = fetch_user_stats(telegram_id)
    api_bal = stats.get('balance', 0.0) if (stats and stats.get('registered')) else 0.0
    local_add = USER_BALANCES.get(int(telegram_id), 0.0)
    return api_bal + local_add

