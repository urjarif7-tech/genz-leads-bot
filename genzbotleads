def save_broadcast(uid, msg):
    body = msg.text if msg.content_type == 'text' else (getattr(msg, 'caption', None) or '')
    db_run(
        "INSERT INTO broadcasts (telegram_id, ts, content_type, body) VALUES (?, ?, ?, ?)",
