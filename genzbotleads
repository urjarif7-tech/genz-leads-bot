def parse_price(text):
    try:
        v = float((text or '').replace(',', '').strip().lower().replace('tk', '').strip())
    except Exception:
        return None
    if not math.isfinite(v) or v <= 0 or v > PRICE_MAX:
        return None
    return round(v, 2)

def set_price(kind, key, value):
    """ডাটাবেসে সেভ হলেই মেমরির দাম বদলায়। (সফল?, আগের দাম)"""
    item = key if kind == 'n' else f"proxy_{key}"
    old = price_item_current(kind, key)
    if db_run("INSERT OR REPLACE INTO prices (item, price) VALUES (?, ?)", [item, float(value)]) is None:
        return False, old
    if kind == 'n':
        SERVICES_PRICES[key] = float(value)
    else:
        PROXY_PRICES[key] = float(value)
    return True, old

