REJECT_COOLDOWN_SECONDS = 24 * 60 * 60 # cancel করলে ২৪ ঘণ্টা cooldown

def db_run(stmt, args=None):
    """Turso ও SQLite দুটোতেই কাজ করে। rows এর লিস্ট রিটার্ন করে, error হলে None।"""
    if TURSO_URL and TURSO_TOKEN:
        result = execute_turso_query(stmt, args)
        if result is None:
            return None
        return [[c.get("value") for c in row] for row in result.get("rows", [])]
    conn = sqlite3.connect(DB_FILE)
    try:
        cur = conn.cursor()
        cur.execute(stmt, args or [])
        rows = cur.fetchall()
        conn.commit()
        return [list(r) for r in rows]
    finally:
        conn.close()

