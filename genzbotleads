def generate_due_query_text(telegram_id):
    uid = str(telegram_id)
    u_data = get_user_db(uid)
    logs = u_data['due_logs']

    text = "📋 **YOUR DUE SUMMARY**\n-------------------------\n"

    if not logs:
        text += "❌ আপনার কোনো ব্যালেন্স এড বা Due রেকর্ড নেই।"
        markup = types.InlineKeyboardMarkup()
        markup.add(types.InlineKeyboardButton("🔙 Back", callback_data="go_welcome"))
        return text, markup

    tot_due = 0.0
    tot_paid = 0.0

    for entry in logs:
        p = float(entry.get('price', 0.0))
        pd = float(entry.get('paid', 0.0))
        rem = max(0.0, p - pd)
        
        tot_due += rem
        tot_paid += pd

        status_tag = "✅ Paid" if rem == 0 else "🔴 Due"
        
        text += f"🛒 Balance {status_tag}\n"
        text += f"Date:        {entry.get('date', 'N/A')}\n"
        text += f"Price:       {p:,.1f} TK\n"
        text += f"Paid:        {pd:,.1f} TK\n"
        text += f"Remaining: {rem:,.1f} TK\n"
        text += "-------------------------\n"

    curr_bal = get_effective_balance(uid)

    text += f"Total Due:   {tot_due:,.1f} TK\n"
    text += f"Total Paid:  {tot_paid:,.1f} TK\n"
    text += f"Balance:     {curr_bal:,.1f} TK\n"
    text += "-------------------------\n"
    text += "MONTHLY SPENDING\n"

    monthly_spend = defaultdict(float)
    for entry in logs:
        try:
            e_date = datetime.strptime(entry.get('date', ''), "%Y-%m-%d")
            m_key = e_date.strftime("%Y-%m")
            monthly_spend[m_key] += float(entry.get('price', 0.0))
        except Exception:
            pass

    bd_now = datetime.utcnow() + timedelta(hours=6)
    month_keys = []
    for i in range(5):
        m_date = bd_now - timedelta(days=30 * i)
        month_keys.append(m_date.strftime("%Y-%m"))

    for m_k in month_keys:
        amt = monthly_spend.get(m_k, 0.0)
        text += f"{m_k}: {amt:,.1f} TK\n"

    markup = types.InlineKeyboardMarkup(row_width=2)
    btn_refresh = types.InlineKeyboardButton("🔄 Refresh", callback_data="due_query")
    btn_back = types.InlineKeyboardButton("🔙 Back", callback_data="go_welcome")
    markup.add(btn_refresh, btn_back)

    return text, markup

