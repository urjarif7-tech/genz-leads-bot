@bot.message_handler(commands=['start'])
def send_welcome(message):
    uid = message.from_user.id
    
    if uid == ADMIN_ID:
        update_user_activity(uid, message.from_user.first_name or "Admin")
        active_messages.pop(message.chat.id, None)
        welcome_text, markup = build_welcome_dashboard("Admin", uid)
        bot.send_message(message.chat.id, welcome_text, parse_mode='Markdown', reply_markup=markup)
        return

    first_name = message.from_user.first_name or ""
    last_name = message.from_user.last_name or ""
    full_name = f"{first_name} {last_name}".strip() or "Unknown"
    
    update_user_activity(uid, full_name)
    
    u_data = get_user_db(uid)
    status = u_data.get('status', 'pending')

    # যদি ইউজার আগে থেকেই অ্যাপ্রুভ হয়ে থাকে, তবে সোজা মেনু দেখাবে
    if status == 'approved':
        active_messages.pop(message.chat.id, None)
        welcome_text, markup = build_welcome_dashboard(first_name, uid)
        bot.send_message(message.chat.id, welcome_text, parse_mode='Markdown', reply_markup=markup)
        return

    # Cooldown Check
    current_time = time.time()
    last_req = u_data.get('last_request', 0.0)

    if status == 'rejected':
        if current_time - last_req < 86400:
            rem_seconds = int(86400 - (current_time - last_req))
            rem_hours = rem_seconds // 3600
            rem_mins = (rem_seconds % 3600) // 60
            bot.send_message(message.chat.id, f"❌ Your request is not approved by admin. You can request again after {rem_hours} hours {rem_mins} minutes.")
            return
        else:
            u_data['status'] = 'pending'
            save_user_db(uid, u_data)

    elif status == 'pending' and last_req > 0:
        if current_time - last_req < 300:
            rem_mins = int((300 - (current_time - last_req)) // 60)
            rem_secs = int((300 - (current_time - last_req)) % 60)
            bot.send_message(message.chat.id, f"⏳ Your request is already pending. Please wait or try again after {rem_mins} minutes {rem_secs} seconds.")
            return

    u_data['last_request'] = current_time
    save_user_db(uid, u_data)

    markup = types.InlineKeyboardMarkup(row_width=2)
    btn_accept = types.InlineKeyboardButton("Accept ✅", callback_data=f"sec_accept_{uid}")
    btn_cancel = types.InlineKeyboardButton("Cancel 🚫", callback_data=f"sec_cancel_{uid}")
    markup.add(btn_accept, btn_cancel)

    admin_msg = (
        f"🔐 **NEW USER APPROVAL REQUEST**\n\n"
        f"👤 Name: {full_name}\n"
        f"🆔 ID: `{uid}`"
    )
    bot.send_message(ADMIN_ID, admin_msg, parse_mode='Markdown', reply_markup=markup)
    bot.send_message(message.chat.id, "Your request has been sent to the admin.")

