bot = telebot.TeleBot(BOT_TOKEN)
API_URL = "https://genzreward.com/api/live-leads-bot"

seen_lead_ids = set()

def fetch_api_leads():
    try:
        response = requests.get(API_URL, timeout=10)
        if response.status_code == 200:
            json_data = response.json()
            # API Response Format Handle (array or object inside data/leads)
            if isinstance(json_data, list):
                return json_data
            elif isinstance(json_data, dict):
                return json_data.get('data', json_data.get('leads', []))
    except Exception as e:
        print(f"API Fetch Error: {e}")
    return []

def build_pagination_keyboard(page=1, total_pages=1):
    markup = InlineKeyboardMarkup()
    buttons = []
    
    if page > 1:
        buttons.append(InlineKeyboardButton("⬅️ Prev", callback_data=f"page_{page-1}"))
    
    buttons.append(InlineKeyboardButton("🔄 Refresh", callback_data=f"page_{page}"))
    
    if page < total_pages:
        buttons.append(InlineKeyboardButton("Next ➡️", callback_data=f"page_{page+1}"))
        
    markup.row(*buttons)
    return markup

def get_lead_page_text(leads, page=1, per_page=3):
    total_leads = len(leads)
    if total_leads == 0:
        return "❌ Currently no live leads found in API.", 0
    
    total_pages = (total_leads + per_page - 1) // per_page
    page = max(1, min(page, total_pages))
    
    start_idx = (page - 1) * per_page
    end_idx = start_idx + per_page
    page_leads = leads[start_idx:end_idx]
    
    text = f"🎯 **Live Leads List** (Page {page}/{total_pages})\n\n"
    for lead in page_leads:
        offer_name = lead.get('offer_name', 'N/A')
        provider = lead.get('provider', 'N/A')
        points = lead.get('points', '0')
        user_id = lead.get('user_id', 'N/A')
        
        text += (
            f"👤 **User ID:** `{user_id}`\n"
            f"📌 **Offer:** {offer_name}\n"
            f"🌐 **Provider:** {provider}\n"
            f"💰 **Reward:** {points} Points\n"
            f"-------------------------------\n"
        )
    return text, total_pages

