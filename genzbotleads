def process_proxy_purchase(call, kind, state_name, quantity):
    cfg = PROXY_KINDS[kind]
    unit_price = proxy_price(kind)
    uid = call.from_user.id
    chat_id = call.message.chat.id

    if get_available_balance(uid) < quantity * unit_price:
        bot.answer_callback_query(call.id, text=f"❌ Insufficient balance! Required: {quantity * unit_price} TK", show_alert=True)
        return

    if not acquire_busy(uid):
        bot.answer_callback_query(call.id, text="⏳ Please wait, your previous request is still processing.", show_alert=True)
        return

    try:
        bot.answer_callback_query(call.id)

        fail_markup = types.InlineKeyboardMarkup(row_width=1)
        fail_markup.add(
            types.InlineKeyboardButton(cfg['states_btn'], callback_data=cfg['states_cb']),
            types.InlineKeyboardButton("🔙 Back", callback_data="menu_items")
        )

        show_page(call, "⏳ Checking proxies, please wait...", None)

        try:
            good = get_verified_proxies(lambda n: cfg['fetch'](n, state_name), quantity)
        except Exception as e:
            print(f"Proxy verify error: {e}")
            good = []

        if not good:
            show_page(
                call,
                f"❌ No working proxy available right now for {state_name}.\nYou were not charged. Please try again or choose another state.",
                fail_markup
            )
            return

        count = len(good)
        cost = count * unit_price
        new_bal = charge_user(uid, cost, f"{cfg['label']} ({state_name})", count)

        if new_bal is False:
            show_page(call, "❌ Insufficient balance. You were not charged.", fail_markup)
            return
        if new_bal is None:
            show_page(call, "⚠️ Database error. You were not charged. Please try again.", fail_markup)
            return

        try:
            bot.delete_message(chat_id, call.message.message_id)
        except Exception:
            pass

        # প্রতিটা proxy আলাদা QR আর আলাদা মেসেজে পাঠানো হয়
        for i, (proxy_url, info) in enumerate(good, start=1):
            caption = (
                f"✅ **{cfg['title']} {i}/{count} VERIFIED**\n\n"
                f"{cfg['line'].format(state=state_name)}\n"
                f"{fmt_proxy_detail(info, state_name)}\n\n"
                f"`{proxy_url}`"
            )
            send_proxy_result(chat_id, make_qr_png(proxy_url), caption)
            if i < count:
                time.sleep(0.3)

        summary_text = (
            f"────────────────────────\n"
            f"✅ Delivered: {count}/{quantity}\n"
            f"💳 Total Charged: {cost} TK\n"
        )
        if count < quantity:
            summary_text += f"⚠️ Only {count} of {quantity} proxies were working, so you were charged for {count} only.\n"
        summary_text += f"\nRemaining Balance: {new_bal} TK"
        markup = types.InlineKeyboardMarkup(row_width=1)
        markup.add(
            types.InlineKeyboardButton(cfg['states_btn'], callback_data=cfg['states_cb']),
            types.InlineKeyboardButton("🔙 Back", callback_data="menu_items")
        )
        bot.send_message(chat_id, summary_text, parse_mode='Markdown', reply_markup=markup)
    finally:
        release_busy(uid)

