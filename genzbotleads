def get_bank(uid):
    """None = database error, {} = কিছু নেই, dict = সেভ করা তথ্য"""
    rows = db_run(
        "SELECT bank_name, account_name, account_number, division, branch, bkash_number FROM bank WHERE telegram_id = ?",
        [str(uid)]
    )
    if rows is None:
        return None
    if not rows:
        return {}
    return {key: (rows[0][i] or '') for i, (key, _) in enumerate(BANK_FIELDS)}

def bank_complete(b):
    return bool(b) and all(b.get(key) for key, _ in BANK_FIELDS)

def save_bank(uid, data):
    res = db_run(
        "INSERT OR REPLACE INTO bank (telegram_id, bank_name, account_name, account_number, division, branch, bkash_number) "
        "VALUES (?, ?, ?, ?, ?, ?, ?)",
        [str(uid)] + [str(data.get(key, '')) for key, _ in BANK_FIELDS]
    )
    return res is not None

