def get_user_db(telegram_id):
    t_id = str(telegram_id).strip()

    if TURSO_URL and TURSO_TOKEN:
        stmt = "SELECT balance, spend, due, paid, purchases, due_logs FROM users WHERE telegram_id = ?"
        result = execute_turso_query(stmt, [t_id])
        if result and result.get("rows"):
            row = result["rows"][0]
            val_balance = float(row[0].get("value", 0.0)) if row[0].get("value") is not None else 0.0
            val_spend = float(row[1].get("value", 0.0)) if row[1].get("value") is not None else 0.0
            val_due = float(row[2].get("value", 0.0)) if row[2].get("value") is not None else 0.0
            val_paid = float(row[3].get("value", 0.0)) if row[3].get("value") is not None else 0.0
            raw_purchases = row[4].get("value", "[]")
            raw_due_logs = row[5].get("value", "[]")

            try:
                purchases = json.loads(raw_purchases) if raw_purchases else []
            except Exception:
                purchases = []
            try:
                due_logs = json.loads(raw_due_logs) if raw_due_logs else []
            except Exception:
                due_logs = []

            return {
                'balance': val_balance,
                'spend': val_spend,
                'due': val_due,
                'paid': val_paid,
                'purchases': purchases,
                'due_logs': due_logs
            }
    else:
        conn = sqlite3.connect(DB_FILE)
        cursor = conn.cursor()
        cursor.execute('SELECT balance, spend, due, paid, purchases, due_logs FROM users WHERE telegram_id = ?', (t_id,))
        row = cursor.fetchone()
        conn.close()

        if row:
            try:
                purchases = json.loads(row[4]) if row[4] else []
            except Exception:
                purchases = []
            try:
                due_logs = json.loads(row[5]) if row[5] else []
            except Exception:
                due_logs = []

            return {
                'balance': float(row[0] or 0.0),
                'spend': float(row[1] or 0.0),
                'due': float(row[2] or 0.0),
                'paid': float(row[3] or 0.0),
                'purchases': purchases,
                'due_logs': due_logs
            }

    return {
        'balance': 0.0,
        'spend': 0.0,
        'due': 0.0,
        'paid': 0.0,
        'purchases': [],
        'due_logs': []
    }

