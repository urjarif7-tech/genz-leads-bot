@bot.callback_query_handler(func=lambda call: call.data.startswith('acc_'))
def handle_access_decision(call):
    if call.from_user.id != ADMIN_ID:
        bot.answer_callback_query(call.id, text="Unauthorized!", show_alert=True)
        return

    _, action, uid = call.data.split('_', 2)
    acc = get_access(uid)

    if acc['status'] != 'pending':
        bot.answer_callback_query(call.id, text=f"Already handled ({acc['status']}).", show_alert=True)
        try:
            bot.edit_message_reply_markup(call.message.chat.id, call.message.message_id, reply_markup=None)
        except Exception:
            pass
        return

    base_text = call.message.html_text or ""

    if action == 'ok':
        set_access(uid, 'approved', acc['full_name'], 0)
        try:
            bot.edit_message_text(base_text + "\n\n✅ <b>Accepted</b>", chat_id=call.message.chat.id,
                                  message_id=call.message.message_id, parse_mode='HTML')
        except Exception:
            pass

        first_name = (acc['full_name'].split() or ["User"])[0]
        try:
            bot.send_message(int(uid), "🎉 Welcome to Genzbot !")
            welcome_text, markup = build_welcome_dashboard(first_name, uid)
            bot.send_message(int(uid), welcome_text, parse_mode='Markdown', reply_markup=markup)
        except Exception as e:
            print(f"Notify approved user error: {e}")
        bot.answer_callback_query(call.id, text="User Accepted ✅")
    else:
        set_access(uid, 'rejected', acc['full_name'], int(time.time()) + REJECT_COOLDOWN_SECONDS)
        try:
            bot.edit_message_text(base_text + "\n\n🚫 <b>Cancelled</b>", chat_id=call.message.chat.id,
                                  message_id=call.message.message_id, parse_mode='HTML')
        except Exception:
            pass
        try:
            bot.send_message(int(uid), "❌ Your request is not approved by admin.")
        except Exception as e:
            print(f"Notify rejected user error: {e}")
        bot.answer_callback_query(call.id, text="User Cancelled 🚫")
