# ---------- /user মেনু: প্রতি ৩০ সেকেন্ডে auto-refresh ----------
USERMENU_AUTO_REFRESH_SECONDS = 30
USERMENU_LIVE_TIMEOUT = 30 * 60   # ৩০ মিনিট কোনো বাটন না চাপলে auto-refresh বন্ধ
USERMENU_LIVE_MAX = 5             # একসাথে সর্বোচ্চ ৫টা মেনু auto-refresh হয়
usermenu_live = {}                # (chat_id, message_id) -> {'uid', 'last_touch'}
usermenu_live_lock = threading.Lock()

def register_usermenu_live(chat_id, message_id, uid):
    with usermenu_live_lock:
        usermenu_live[(chat_id, message_id)] = {'uid': str(uid), 'last_touch': time.time()}
        while len(usermenu_live) > USERMENU_LIVE_MAX:
            oldest = min(usermenu_live, key=lambda k: usermenu_live[k]['last_touch'])
            usermenu_live.pop(oldest, None)

def unregister_usermenu_live(chat_id, message_id):
    with usermenu_live_lock:
        usermenu_live.pop((chat_id, message_id), None)

def usermenu_refresh_once():
    with usermenu_live_lock:
        snapshot = list(usermenu_live.items())
    now = time.time()
    for key, info in snapshot:
        chat_id, message_id = key
        if now - info['last_touch'] > USERMENU_LIVE_TIMEOUT:
            unregister_usermenu_live(chat_id, message_id)
            continue

        text, markup = build_user_admin_menu(info['uid'])

        # তৈরি করার সময় অ্যাডমিন অন্য পেজে (History/Due/Bank) চলে গেলে মেনু দিয়ে ঢেকে দেব না
        with usermenu_live_lock:
            if key not in usermenu_live:
                continue
        try:
            bot.edit_message_text(text, chat_id=chat_id, message_id=message_id,
                                  parse_mode='Markdown', reply_markup=markup)
        except Exception as e:
            err = str(e).lower()
            if 'not modified' in err:
                pass
            elif 'not found' in err or "can't be edited" in err or 'chat not found' in err:
                unregister_usermenu_live(chat_id, message_id)   # মেসেজ মুছে গেছে
            else:
                print(f"User menu auto-refresh error: {e}")

def usermenu_auto_refresh_loop():
    while True:
        time.sleep(USERMENU_AUTO_REFRESH_SECONDS)
        try:
            usermenu_refresh_once()
        except Exception as e:
            print(f"User menu refresh loop error: {e}")

