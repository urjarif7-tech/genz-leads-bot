@bot.callback_query_handler(func=lambda call: call.data == 'go_welcome')
def handle_back_to_welcome(call):
    active_messages.pop(call.message.chat.id, None)
    welcome_text, markup = build_welcome_dashboard(call.from_user.first_name or "User", call.from_user.id)
    
    try:
        if call.message.content_type == 'photo':
            bot.delete_message(call.message.chat.id, call.message.message_id)
            bot.send_message(call.message.chat.id, welcome_text, parse_mode='Markdown', reply_markup=markup)
        else:
            bot.edit_message_text(
                chat_id=call.message.chat.id,
                message_id=call.message.message_id,
                text=welcome_text,
                parse_mode='Markdown',
                reply_markup=markup
            )
    except Exception:
        bot.send_message(call.message.chat.id, welcome_text, parse_mode='Markdown', reply_markup=markup)
    bot.answer_callback_query(call.id)

