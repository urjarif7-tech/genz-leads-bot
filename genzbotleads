@bot.callback_query_handler(func=lambda call: call.data.startswith('numget_'))
def handle_durian_get_numbers(call):
    parts = call.data.split('_')
    country_code = parts[1]
    service_name = parts[2]
    qty = max(1, min(int(parts[3]), 3))
    uid = call.from_user.id
    price = SERVICES_PRICES.get(service_name, 10.0)
    total_cost = price * qty

    if get_available_balance(uid) < total_cost:
        bot.answer_callback_query(call.id, text=f"❌ Insufficient balance! Required: {total_cost} TK", show_alert=True)
        return

    if not acquire_busy(uid):
        bot.answer_callback_query(call.id, text="⏳ Please wait, your previous request is still processing.", show_alert=True)
        return

    try:
        bot.answer_callback_query(call.id)
        chat_id = call.message.chat.id
        back_markup = number_service_markup(country_code, service_name)

        for _ in range(qty):
            r = reserve_hold(uid, price)
            if r is None:
                bot.send_message(chat_id, "⚠️ Database error. You were not charged. Please try again later.", reply_markup=back_markup)
                break
            if r is False:
                bot.send_message(chat_id, "❌ Insufficient balance for more numbers.", reply_markup=back_markup)
                break

            num_str, order_id = get_durian_number_api(service_name, country_code)
            if not num_str:
                release_hold(uid, price)
                bot.send_message(
                    chat_id,
                    f"❌ No {service_name} number available right now.\nYou were not charged. Please try again later.",
                    reply_markup=back_markup
                )
                break

            token = uuid.uuid4().hex[:10]
            with orders_lock:
                active_orders[order_id] = {'uid': uid, 'price': price, 'num': num_str, 'service': service_name}
                block_tokens[token] = {'order_id': order_id, 'num': num_str, 'uid': uid}

            text = (
                f"📱 **YOUR NUMBER**\n\n"
                f"Number: `{num_str}`\n"
                f"Service: {service_name}\n\n"
                f"⏳ Waiting for SMS code... (2 minutes)\n"
                f"🚫 Block button unlocks in 45s"
            )

            markup = types.InlineKeyboardMarkup(row_width=2)
            btn_block = types.InlineKeyboardButton("🚫 Block Number", callback_data=f"numblock_{token}")
            btn_again = types.InlineKeyboardButton("🔄 Purchase Again", callback_data=f"numsrv_{country_code}_{service_name}")
            btn_back = types.InlineKeyboardButton("🔙 Back", callback_data=f"numsrv_{country_code}_{service_name}")
            markup.add(btn_block, btn_again)
            markup.add(btn_back)

            sent_msg = bot.send_message(chat_id, text, parse_mode='Markdown', reply_markup=markup)

            threading.Thread(
                target=poll_durian_sms,
                args=(chat_id, sent_msg.message_id, num_str, order_id, service_name, price, country_code, uid, token),
                daemon=True
            ).start()
    finally:
        release_busy(uid)

def poll_durian_sms(chat_id, msg_id, num_str, order_id, service_name, price, country_code, user_id, token):
    start_time = time.time()
    sms_code = None

    while time.time() - start_time < 120:
        time.sleep(5)
        with orders_lock:
            if order_id not in active_orders:
                return   # ইউজার নিজে block করেছে, hold আগেই ছাড়া হয়েছে
        try:
            url = f"{DURIAN_BASE_URL}/get_sms?apikey={DURIANRCS_API_KEY}&id={order_id}"
            res = requests.get(url, timeout=5)
            if res.status_code == 200:
                data = res.json()
                if data.get('status') == 'success' and data.get('code'):
                    sms_code = data.get('code')
                    break
        except Exception:
            pass

    order = pop_active_order(order_id)
    if order is None:
        return   # ইতোমধ্যে block হয়ে গেছে

    if sms_code:
        # SMS এসেছে -> আটকানো টাকা ছেড়ে এখন আসলেই কাটি
        release_hold(user_id, price)
        new_bal = charge_user(user_id, price, f"📱 {service_name} Number", 1, force=True)
        if new_bal is None:
            print(f"CHARGE FAILED for user {user_id}: {price} TK ({service_name})")
            try:
                bot.send_message(
                    ADMIN_ID,
                    f"⚠️ Charge failed (database error)\nUser: {user_id}\nService: {service_name}\n"
                    f"Please add manually: /adddue {user_id} {price}"
                )
            except Exception:
                pass
            rem_bal = get_effective_balance(user_id)
        else:
            rem_bal = new_bal

        text = (
            f"✅ **SMS RECEIVED!**\n\n"
            f"Number: `{num_str}`\n"
            f"Service: {service_name}\n"
            f"Code: `{sms_code}`\n\n"
            f"💳 {price} TK deducted\n"
            f"Remaining: {rem_bal} TK"
        )
        markup = types.InlineKeyboardMarkup(row_width=2)
        btn_block = types.InlineKeyboardButton("🚫 Block Number", callback_data=f"numblock_{token}")
        btn_again = types.InlineKeyboardButton("🔄 Purchase Again", callback_data=f"numsrv_{country_code}_{service_name}")
        btn_back = types.InlineKeyboardButton("🔙 Back", callback_data="go_welcome")
        markup.add(btn_block, btn_again)
        markup.add(btn_back)

        try:
            bot.edit_message_text(text, chat_id=chat_id, message_id=msg_id, parse_mode='Markdown', reply_markup=markup)
        except Exception:
            pass

        time.sleep(60)
        cancel_durian_number_api(order_id)
