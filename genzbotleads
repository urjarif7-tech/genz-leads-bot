import os
import requests
from flask import Flask
from telebot import TeleBot, types

# Environment variables setup
BOT_TOKEN = os.environ.get('BOT_TOKEN', '8809930723:AAH2LExR_Mkn3Y-PfuojEL8sOQIiQJa0Tsc')
API_URL = 'https://genzreward.com/api/live-leads-bot'

bot = TeleBot(BOT_TOKEN)
app = Flask(__name__)

def fetch_leads(page=1):
    try:
        response = requests.get(f"{API_URL}?page={page}", timeout=10)
        if response.status_code == 200:
            return response.json()
    except Exception as e:
        print(f"Error fetching data: {e}")
    return None

def build_lead_message(data):
    leads = data.get('data', [])
    current_page = data.get('current_page', 1)
    last_page = data.get('last_page', 1)

    if not leads:
        return "🎯 **No Live Leads Found!**", None

    message_text = f"🎯 **Live Leads List (Page {current_page}/{last_page})**\n\n"
    
    for lead in leads:
        user_id = lead.get('user_id', 'N/A')
        offer_name = lead.get('offer_name', 'N/A')
        provider = lead.get('provider', 'N/A')
        points = lead.get('points', '0')
        time_ago = lead.get('time_ago', 'Just now')

        message_text += f"👤 **User ID:** {user_id}\n"
        message_text += f"📌 **Offer:** {offer_name}\n"
        message_text += f"🌐 **Provider:** {provider}\n"
        message_text += f"💰 **Reward:** {points} Points\n"
        message_text += f"⏱️ **Time:** {time_ago}\n"
        message_text += f"-----------------------------------\n"

    # Inline Keyboard pagination
    markup = types.InlineKeyboardMarkup()
    buttons = []

    if current_page > 1:
        buttons.append(types.InlineKeyboardButton("⬅️ Prev", callback_data=f"page_{current_page - 1}"))
    
    buttons.append(types.InlineKeyboardButton("🔄 Refresh", callback_data=f"page_{current_page}"))

    if current_page < last_page:
        buttons.append(types.InlineKeyboardButton("Next ➡️", callback_data=f"page_{current_page + 1}"))

    markup.row(*buttons)
    return message_text, markup

@bot.message_handler(commands=['start', 'leads'])
def send_leads(message):
    data = fetch_leads(page=1)
    if data:
        msg_text, markup = build_lead_message(data)
        bot.send_message(message.chat.id, msg_text, parse_mode='Markdown', reply_markup=markup)
    else:
        bot.send_message(message.chat.id, "❌ Could not fetch live leads. Please try again later.")

@bot.callback_query_handler(func=lambda call: call.data.startswith('page_'))
def handle_pagination(call):
    page = int(call.data.split('_')[1])
    data = fetch_leads(page=page)
    
    if data:
        msg_text, markup = build_lead_message(data)
        try:
            bot.edit_message_text(
                chat_id=call.message.chat.id,
                message_id=call.message.message_id,
                text=msg_text,
                parse_mode='Markdown',
                reply_markup=markup
            )
            bot.answer_callback_query(call.id, text="🔄 Refreshed!")
        except Exception as e:
            if "message is not modified" in str(e).lower():
                bot.answer_callback_query(call.id, text="⚡ Already up to date!")
            else:
                bot.answer_callback_query(call.id, text="❌ Update failed")
    else:
        bot.answer_callback_query(call.id, text="❌ Could not fetch data")

@app.route('/')
def home():
    return "Telegram Bot Server is Running!"

if __name__ == '__main__':
    # Flask web server setup for Render port binding
    port = int(os.environ.get('PORT', 5000))
    import threading
    threading.Thread(target=lambda: app.run(host='0.0.0.0', port=port), daemon=True).start()
    bot.infinity_polling()
